import hash
//
// Clyth V1.0.0 primitive-first runtime Map.
//
// Map<K,V> is intentionally implemented in Clyth-space using only language
// primitives the compiler should own: structs, generic structs, arrays,
// constructors, and methods. Hash buckets/module-hash can replace this backing
// later without reintroducing compiler-owned Map lowering.

struct MapEntry<K, V> {
    K key
    V value

    constructor(K input_key, V input_value) {
        key = input_key
        value = input_value
    }
}

struct Map<K, V> {
    private MapEntry<K, V>[] entries
    int64 length
    int64 capacity



    constructor(MapEntry<K, V>[] initial_entries) {
        entries = initial_entries
        length = initial_entries.length
        capacity = initial_entries.length
    }

    bool empty() {
        return length == 0
    }

    bool contains_key(K key) {
        int64 i = 0
        while i < length {
            MapEntry<K, V> entry = entries[i]
            if entry.key == key {
                return true
            }
            i += 1
        }
        return false
    }

    V get(K key) {
        // Search from the end so duplicate keyed-array constructor entries behave
        // like later writes overriding earlier writes. This preserves the sample
        // behavior while the hash-backed runtime implementation is still pending.
        int64 i = length
        while i > 0 {
            i -= 1
            MapEntry<K, V> entry = entries[i]
            if entry.key == key {
                return entry.value
            }
        }

        V default_value
        return default_value
    }

    void put(K key, V value) {
        int64 i = 0
        while i < length {
            MapEntry<K, V> entry = entries[i]
            if entry.key == key {
                entry.value = value
                entries[i] = entry
                return
            }
            i += 1
        }

        ensure_capacity(length + 1)
        entries[length] = MapEntry<K, V>(key, value)
        length += 1
    }

    K[] keys() {
        K[] result = array<K>(length)
        int64 i = 0
        while i < length {
            result[i] = entries[i].key
            i += 1
        }
        return result
    }

    V[] values() {
        V[] result = array<V>(length)
        int64 i = 0
        while i < length {
            result[i] = entries[i].value
            i += 1
        }
        return result
    }

    bool remove(K key) {
        int64 i = 0
        while i < length {
            MapEntry<K, V> entry = entries[i]
            if entry.key == key {
                int64 j = i
                while j < length - 1 {
                    entries[j] = entries[j + 1]
                    j += 1
                }
                length -= 1
                return true
            }
            i += 1
        }
        return false
    }

    void clear() {
        length = 0
    }

    private void ensure_capacity(int64 required_capacity) {
        if capacity >= required_capacity {
            return
        }
        int64 next_capacity = capacity
        if next_capacity == 0 {
            next_capacity = 4
        }
        while next_capacity < required_capacity {
            next_capacity *= 2
        }
        MapEntry<K, V>[] replacement = array<MapEntry<K, V>>(next_capacity)
        int64 copy_index = 0
        while copy_index < length {
            replacement[copy_index] = entries[copy_index]
            copy_index += 1
        }
        entries = replacement
        capacity = next_capacity
    }
}
