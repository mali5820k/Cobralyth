    string return_ty=llvm_type(lowerer,result_sem);string[] arg_text;i=0;while i<arguments.length{int64 n=arg_text.length;arg_text = array<string>(arg_text, n+1);arg_text[n]=arguments[i].llvm_type+" "+arguments[i].value;i+=1};string callee_text="@"+function_name;if indirect!=""{callee_text=indirect}
    if function_name!=""&&!lowerer.defined[function_name]&&lowerer.declarations[function_name]=="" {string[] declaration_args;if arguments.length>0{i=0;while i<arguments.length{int64 n=declaration_args.length;declaration_args = array<string>(declaration_args, n+1);declaration_args[n]=arguments[i].llvm_type;i+=1}}else{i=0;while i<expected.length{int64 n=declaration_args.length;declaration_args = array<string>(declaration_args, n+1);declaration_args[n]=llvm_type(lowerer,expected[i]);i+=1}};if variadic{int64 n=declaration_args.length;declaration_args = array<string>(declaration_args, n+1);declaration_args[n]="..."};lowerer.declarations[function_name]="declare "+return_ty+" @"+function_name+"("+join_llvm_strings(declaration_args,", ")+")"}
