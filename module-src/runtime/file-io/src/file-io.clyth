struct Permissions {
    int8 owner,
    int8 group,
    int8 other,
}

Permissions get_permissions(string path) {
    Permissions value = Permissions()
    value.owner = permission_owner(path)
    value.group = permission_group(path)
    value.other = permission_other(path)
    return value
}

