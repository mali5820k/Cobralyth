int32 MEMBER_METHOD = 2
int32 MEMBER_CONSTRUCTOR = 3
int32 MEMBER_DESTRUCTOR = 4

Span decl_span(Decl value) {
    if value.kind == DECL_MECC_CONFIG { return value.mecc_config.SourceSpan }
    if value.kind == DECL_ERROR_TYPE { return value.error_type.SourceSpan }
    if value.kind == DECL_IMPORT { return value.import_decl.SourceSpan }
    if value.kind == DECL_FUNCTION { return value.function_decl.SourceSpan }
    if value.kind == DECL_STRUCT { return value.struct_decl.SourceSpan }
    if value.kind == DECL_ENUM { return value.enum_decl.SourceSpan }
    if value.kind == DECL_METHOD_BLOCK { return value.method_block_decl.SourceSpan }
    if value.kind == DECL_PROTOCOL { return value.protocol_decl.SourceSpan }
    if value.kind == DECL_GLOBAL_VAR { return value.global_var_decl.SourceSpan }
    Span empty
    return empty
}

Span stmt_span(Stmt value) {
    if value.kind == STMT_BLOCK { return value.block_stmt.SourceSpan }
    if value.kind == STMT_MECC_CONFIG { return value.mecc_config.SourceSpan }
    if value.kind == STMT_VAR { return value.var_decl.SourceSpan }
    if value.kind == STMT_RETURN { return value.return_stmt.SourceSpan }
    if value.kind == STMT_IF { return value.if_stmt.SourceSpan }
    if value.kind == STMT_WHILE { return value.while_stmt.SourceSpan }
    if value.kind == STMT_FOR { return value.for_stmt.SourceSpan }
    if value.kind == STMT_SWITCH { return value.switch_stmt.SourceSpan }
    if value.kind == STMT_BREAK { return value.break_stmt.SourceSpan }
    if value.kind == STMT_CONTINUE { return value.continue_stmt.SourceSpan }
    if value.kind == STMT_EXPR { return value.expr_stmt.SourceSpan }
    Span empty
    return empty
}

Span expr_span(Expr value) {
    if value.kind == EXPR_IDENTIFIER { return value.identifier.SourceSpan }
    if value.kind == EXPR_LITERAL { return value.literal.SourceSpan }
    if value.kind == EXPR_UNARY { return value.unary.SourceSpan }
    if value.kind == EXPR_BINARY { return value.binary.SourceSpan }
    if value.kind == EXPR_ASSIGN { return value.assign.SourceSpan }
    if value.kind == EXPR_CALL { return value.call.SourceSpan }
    if value.kind == EXPR_GENERIC_SPECIALIZATION { return value.generic_specialization.SourceSpan }
    if value.kind == EXPR_MEMBER { return value.member.SourceSpan }
    if value.kind == EXPR_INDEX { return value.index.SourceSpan }
    if value.kind == EXPR_ARRAY { return value.array.SourceSpan }
    if value.kind == EXPR_KEY_VALUE { return value.key_value.SourceSpan }
    if value.kind == EXPR_LAMBDA { return value.lambda.SourceSpan }
    if value.kind == EXPR_NEW { return value.new_expr.SourceSpan }
    if value.kind == EXPR_CAST { return value.cast_expr.SourceSpan }
    Span empty
    return empty
}

Span member_span(StructMember value) {
    if value.kind == MEMBER_FIELD { return value.field.SourceSpan }
    if value.kind == MEMBER_METHOD { return value.method.Function.SourceSpan }
    if value.kind == MEMBER_CONSTRUCTOR { return value.constructor_member.Constructor.SourceSpan }
    if value.kind == MEMBER_DESTRUCTOR { return value.destructor_member.Destructor.SourceSpan }
    Span empty
    return empty
}

