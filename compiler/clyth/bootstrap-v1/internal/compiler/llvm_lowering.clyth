// IRValue is the SSA value returned by the textual LLVM lowering layer.
// Aggregate Clyth values are deliberately represented by opaque LLVM pointers in
// the bootstrap backend. This keeps native ABI details isolated while the frontend
// and self-hosted compiler stabilize.
struct IRValue {
	string llvm_type
	string value
	SemanticType* type_info
	fresh     bool // unique aggregate temporary; value-copy destinations may consume it directly
}

struct ir_local {
	string address
	SemanticType* type_info
}

struct value_cleanup {
	string address
	SemanticType* type_info
}

struct catch_context {
	string error_value
	string end_label
	int64 block_depth
}

struct llvm_lowerer {
	AnalysisResult* result
	Program* program
	string target
	string[] strings
	Map<string, string> declarations
	Map<string, bool> defined
	Map<string, StructInfo*> struct_info
	Map<string, Map<string, int64>> enum_values
	int64 register
	int64 label
	int64 lambda
	string[] function_defs
	string[] global_defs
	Map<string, ir_local> globals
	string[] current_lines
	string current_block
	Map<string, ir_local> locals
	string[] break_labels
	string[] continue_labels
	int64[] break_cleanup_depths
	int64[] continue_cleanup_depths
	SemanticType* return_type
	StructInfo* receiver
	Map<string, SemanticType*> substitutions
	GenericSpecialization[] external_specializations
	string main_args_name
	string main_argc_value
	Map<Node, LifetimeAction[]> lifetime_actions
	Map<int64, string> cleanup_slots
	catch_context[] catch_stack
	BlockStmt*[] block_stack
	string[][] mecc_root_scopes
	value_cleanup[][] value_cleanup_scopes
	value_cleanup[] pending_parameter_cleanups
}

struct BootstrapVariadicPackResult { IRValue value IRValue[] temporaries bool ok }
struct BootstrapInterpolationArgumentResult { string llvm_type IRValue value bool ok }
struct BootstrapActiveCatchResult { catch_context context bool ok }
struct BootstrapAssignmentAddressResult { string address SemanticType* type_info bool ok }
struct BootstrapAssignmentAddressOwnerResult { string address SemanticType* type_info string owner bool ok }
struct BootstrapLLVMResult { string ir string error_message bool ok }

// lower_llvm_ir converts a semantically-resolved Clyth translation unit into
// textual LLVM IR. The bootstrap backend favors a small, deterministic ABI:
// primitive scalars retain their natural LLVM widths and Clyth aggregate values
// are passed as opaque pointers.
BootstrapLLVMResult lower_llvm_ir(Program* program, AnalysisResult* result, string target) {
    GenericSpecialization[] none
    return lower_llvm_ir_with_specializations(program, result, target, none)
}

// lower_llvm_ir_with_specializations lowers a translation unit while honoring
// concrete generic instantiations requested by another unit.
BootstrapLLVMResult lower_llvm_ir_with_specializations(Program* program, AnalysisResult* result, string target, GenericSpecialization[] external_specializations) {
    BootstrapLLVMResult lowered; lowered.ok = true
    if target == "" { target = "x86_64-unknown-linux-musl" }
    llvm_lowerer* lowerer = new llvm_lowerer(); lowerer.result=result; lowerer.program=program; lowerer.target=target
    lowerer.declarations=Map<string,string>(); lowerer.defined=Map<string,bool>(); lowerer.struct_info=Map<string,StructInfo*>(); lowerer.enum_values=Map<string,Map<string,int64>>(); lowerer.globals=Map<string,ir_local>(); lowerer.external_specializations=external_specializations; lowerer.substitutions=Map<string,SemanticType*>(); lowerer.lifetime_actions=Map<Node,LifetimeAction[]>(); lowerer.cleanup_slots=Map<int64,string>()
    int64 i=0
    while i<result.lifetime_actions.length { LifetimeAction action=result.lifetime_actions[i]; LifetimeAction[] actions=lowerer.lifetime_actions[action.node]; int64 n=actions.length; actions = array<LifetimeAction>(actions, n+1); actions[n]=action; lowerer.lifetime_actions[action.node]=actions; i+=1 }
    collect_types_and_defined_symbols(lowerer); install_builtin_error_struct(lowerer); emit_top_level(lowerer)
    if !lowerer.defined["malloc"] {lowerer.declarations["malloc"]="declare ptr @malloc(i64)"}
    if !lowerer.defined["calloc"] {lowerer.declarations["calloc"]="declare ptr @calloc(i64, i64)"}
    if !lowerer.defined["strlen"] {lowerer.declarations["strlen"]="declare i64 @strlen(ptr)"}
    if !lowerer.defined["strcmp"] {lowerer.declarations["strcmp"]="declare i32 @strcmp(ptr, ptr)"}
    if !lowerer.defined["memcpy"] {lowerer.declarations["memcpy"]="declare ptr @memcpy(ptr, ptr, i64)"}
    if !lowerer.defined["memset"] {lowerer.declarations["memset"]="declare ptr @memset(ptr, i32, i64)"}
    if !lowerer.defined["snprintf"] {lowerer.declarations["snprintf"]="declare i32 @snprintf(ptr, i64, ptr, ...)"}
    if !lowerer.defined["free"] {lowerer.declarations["free"]="declare void @free(ptr)"}
    if !lowerer.defined["abort"] {lowerer.declarations["abort"]="declare void @abort() noreturn"}
    if result.mecc_enabled {lowerer.declarations["clyth_mecc_adopt"]="declare ptr @clyth_mecc_adopt(ptr, i1, ptr)";lowerer.declarations["clyth_mecc_store"]="declare void @clyth_mecc_store(ptr, ptr, ptr)";lowerer.declarations["clyth_mecc_owner_release"]="declare void @clyth_mecc_owner_release(ptr)";lowerer.declarations["clyth_mecc_collapse"]="declare void @clyth_mecc_collapse()";lowerer.declarations["clyth_mecc_release"]="declare void @clyth_mecc_release(ptr)"}
    string output="; Clyth V1.0.0 bootstrap LLVM IR\n"+"target triple = \""+target+"\"\n\n"
    i=0
    while i<lowerer.strings.length {string text=lowerer.strings[i];uint8[] bytes;int64 length=bootstrap_string_length(text);bytes = array<uint8>(bytes, length+1);int64 j=0;while j<length{bytes[j]=text[j];j+=1};bytes[length]=0;output = output + "@.clyth.str."+`${i}`+" = private unnamed_addr constant ["+`${bytes.length}`+" x i8] c\""+llvm_escape_bytes(bytes)+"\"\n";i+=1}
    if lowerer.strings.length>0 {output = output + "\n"}
    i=0;while i<lowerer.global_defs.length{output = output + lowerer.global_defs[i]+"\n";i+=1};if lowerer.global_defs.length>0{output = output + "\n"}
    string[] declaration_names=lowerer.declarations.keys(); string[] filtered; i=0;while i<declaration_names.length{string name=declaration_names[i];if !lowerer.defined[name]{int64 n=filtered.length;filtered = array<string>(filtered, n+1);filtered[n]=name};i+=1};sort_strings(filtered);i=0;while i<filtered.length{output = output + lowerer.declarations[filtered[i]]+"\n";i+=1};if filtered.length>0{output = output + "\n"}
    i=0;while i<lowerer.function_defs.length{output = output + lowerer.function_defs[i];if bootstrap_string_length(lowerer.function_defs[i])==0||bootstrap_string_slice(lowerer.function_defs[i],bootstrap_string_length(lowerer.function_defs[i])-1,1)!="\n"{output = output + "\n"};output = output + "\n";i+=1}
    lowered.ir=output; return lowered
}

void sort_strings(string[] values) {
    int64 i = 1
    while i < values.length {
        string value = values[i]
        int64 j = i
        while j > 0 && values[j - 1] > value { values[j] = values[j - 1]; j -= 1 }
        values[j] = value
        i += 1
    }
}

string llvm_escape_bytes(uint8[] bytes) {
    string digits = "0123456789ABCDEF"
    string output = ""
    int64 i = 0
    while i < bytes.length {
        int64 value = bytes[i]
        if value >= 32 && value <= 126 && value != 34 && value != 92 {
            output = output + `${bytes[i]}`
        } else {
            int64 high = value / 16
            int64 low = value % 16
            output = output + "\\" + bootstrap_string_slice(digits, high, 1) + bootstrap_string_slice(digits, low, 1)
        }
        i += 1
    }
    return output
}

GenericSpecialization[] requested_specializations(llvm_lowerer* lowerer, string base_name) {
    GenericSpecialization[] output
    Map<string, bool> seen = Map<string, bool>()
    int64 i = 0
    while i < lowerer.result.specializations.length {
        GenericSpecialization item = lowerer.result.specializations[i]
        if item.base_name == base_name && specialization_is_concrete(item) { string key=specialization_name(base_name,item.type_arguments); if !seen[key] { seen[key]=true; auto n=output.length; output = array<GenericSpecialization>(output, n+1); output[n]=item } }
        i += 1
    }
    i = 0
    while i < lowerer.external_specializations.length {
        GenericSpecialization item = lowerer.external_specializations[i]
        if item.base_name == base_name && specialization_is_concrete(item) { string key=specialization_name(base_name,item.type_arguments); if !seen[key] { seen[key]=true; auto n=output.length; output = array<GenericSpecialization>(output, n+1); output[n]=item } }
        i += 1
    }
    return output
}

void collect_concrete_generic_types(SemanticType* type_info, Map<string, GenericSpecialization> found) {
    if type_info == null { return }
    if type_info.generic_args.length > 0 { GenericSpecialization specialization; specialization.base_name=type_info.name; specialization.concrete_name=specialization_name(type_info.name,type_info.generic_args); specialization.type_arguments=type_info.generic_args; if specialization_is_concrete(specialization) { found[specialization.concrete_name]=specialization } }
    int64 i=0; while i<type_info.generic_args.length { collect_concrete_generic_types(type_info.generic_args[i],found); i+=1 }
    if type_info.callable != null { collect_concrete_generic_types(type_info.callable.return_type,found); i=0; while i<type_info.callable.parameters.length {collect_concrete_generic_types(type_info.callable.parameters[i],found); i+=1} }
}

void expand_nested_specializations(llvm_lowerer* lowerer) {
    Map<string, GenericSpecialization> found = Map<string, GenericSpecialization>()
    int64 i = 0
    while i < lowerer.result.specializations.length {
        GenericSpecialization specialization = lowerer.result.specializations[i]
        if specialization_is_concrete(specialization) { found[specialization.concrete_name] = specialization }
        i += 1
    }
    i = 0
    while i < lowerer.external_specializations.length {
        GenericSpecialization specialization = lowerer.external_specializations[i]
        if specialization_is_concrete(specialization) { found[specialization.concrete_name] = specialization }
        i += 1
    }
    bool changed = true
    while changed {
        changed = false
        string[] names = found.keys()
        i = 0
        while i < names.length {
            GenericSpecialization specialization = found[names[i]]
            StructInfo* template = lowerer.struct_info[specialization.base_name]
            if template != null {
                StructInfo* concrete = specialized_struct_info(template, specialization.type_arguments)
                if concrete != null {
                    string[] field_names = concrete.fields.keys()
                    int64 j = 0
                    while j < field_names.length {
                        Symbol* field = concrete.fields[field_names[j]]
                        int64 before = found.length
                        if field != null { collect_concrete_generic_types(field.type_info, found) }
                        if found.length > before { changed = true }
                        j += 1
                    }
                    string[] method_names = concrete.methods.keys()
                    j = 0
                    while j < method_names.length {
                        Symbol* method = concrete.methods[method_names[j]]
                        int64 before = found.length
                        if method != null { collect_concrete_generic_types(method.type_info, found) }
                        if found.length > before { changed = true }
                        j += 1
                    }
                }
            }
            i += 1
        }
    }
    string[] names = found.keys()
    i = 0
    while i < names.length {
        GenericSpecialization specialization = found[names[i]]
        bool present = false
        int64 j = 0
        while j < lowerer.external_specializations.length {
            if lowerer.external_specializations[j].concrete_name == specialization.concrete_name { present = true; break }
            j += 1
        }
        if !present {
            int64 n = lowerer.external_specializations.length
            lowerer.external_specializations = array<GenericSpecialization>(lowerer.external_specializations, n + 1)
            lowerer.external_specializations[n] = specialization
        }
        i += 1
    }
}

void collect_types_and_defined_symbols(llvm_lowerer* lowerer) {
    Namespace*[] namespace_values = lowerer.result.namespaces.values()
    int64 namespace_index = 0
    while namespace_index < namespace_values.length {
        Namespace* namespace = namespace_values[namespace_index]
        string[] struct_names = namespace.structs.keys()
        int64 struct_index = 0
        while struct_index < struct_names.length {
            string name = struct_names[struct_index]
            StructInfo* info = namespace.structs[name]
            if lowerer.struct_info[name] == null { lowerer.struct_info[name] = info }
            GenericSpecialization[] specs = requested_specializations(lowerer, name)
            int64 spec_index = 0
            while spec_index < specs.length {
                StructInfo* concrete = specialized_struct_info(info, specs[spec_index].type_arguments)
                if concrete != null { lowerer.struct_info[concrete.name] = concrete }
                spec_index += 1
            }
            struct_index += 1
        }
        namespace_index += 1
    }

    expand_nested_specializations(lowerer)

    string[] known_struct_names = lowerer.struct_info.keys()
    int64 known_index = 0
    while known_index < known_struct_names.length {
        string name = known_struct_names[known_index]
        StructInfo* info = lowerer.struct_info[name]
        if info != null && info.generic_parameters.length > 0 {
            GenericSpecialization[] specs = requested_specializations(lowerer, name)
            int64 spec_index = 0
            while spec_index < specs.length {
                StructInfo* concrete = specialized_struct_info(info, specs[spec_index].type_arguments)
                if concrete != null { lowerer.struct_info[concrete.name] = concrete }
                spec_index += 1
            }
        }
        known_index += 1
    }

    int64 declaration_index = 0
    while declaration_index < lowerer.program.Declarations.length {
        Decl declaration = lowerer.program.Declarations[declaration_index]
        if declaration.kind == DECL_STRUCT {
            StructDecl* item = bootstrap_as_struct_decl(declaration)
            StructInfo* info = lowerer.result.root_namespace.structs[item.Name]
            if info != null { lowerer.struct_info[item.Name] = info }
            if item.GenericParameters.length == 0 {
                int64 member_index = 0
                while member_index < item.Members.length {
                    StructMember member = item.Members[member_index]
                    if member.kind == MEMBER_METHOD {
                        MethodDecl* method = bootstrap_as_method_decl(member)
                        lowerer.defined[llvm_method_name(item.Name, method.Name)] = true
                    } else if member.kind == MEMBER_CONSTRUCTOR {
                        lowerer.defined[llvm_constructor_name(item.Name)] = true
                    } else if member.kind == MEMBER_DESTRUCTOR {
                        lowerer.defined[llvm_destructor_name(item.Name)] = true
                    }
                    member_index += 1
                }
            } else if info != null {
                GenericSpecialization[] specs = requested_specializations(lowerer, item.Name)
                int64 spec_index = 0
                while spec_index < specs.length {
                    StructInfo* concrete = specialized_struct_info(info, specs[spec_index].type_arguments)
                    if concrete != null {
                        lowerer.struct_info[concrete.name] = concrete
                        int64 member_index = 0
                        while member_index < item.Members.length {
                            StructMember member = item.Members[member_index]
                            if member.kind == MEMBER_METHOD {
                                MethodDecl* method = bootstrap_as_method_decl(member)
                                lowerer.defined[llvm_method_name(concrete.name, method.Name)] = true
                            } else if member.kind == MEMBER_CONSTRUCTOR {
                                lowerer.defined[llvm_constructor_name(concrete.name)] = true
                            }
                            member_index += 1
                        }
                    }
                    spec_index += 1
                }
            }
        } else if declaration.kind == DECL_METHOD_BLOCK {
            MethodBlockDecl* item = bootstrap_as_method_block_decl(declaration)
            string receiver = item.Receiver.Name
            StructInfo* info = lowerer.result.root_namespace.structs[receiver]
            if info != null { lowerer.struct_info[receiver] = info }
            int64 member_index = 0
            while member_index < item.Members.length {
                StructMember member = item.Members[member_index]
                if member.kind == MEMBER_METHOD {
                    MethodDecl* method = bootstrap_as_method_decl(member)
                    lowerer.defined[llvm_method_name(receiver, method.Name)] = true
                }
                member_index += 1
            }
        } else if declaration.kind == DECL_FUNCTION {
            FunctionDecl* item = bootstrap_as_function_decl(declaration)
            lowerer.defined[llvm_function_name(item)] = item.Body != null && !item.Extern
            if item.Extern { lowerer.declarations[item.Name] = function_declaration(lowerer, item) }
        } else if declaration.kind == DECL_GLOBAL_VAR {
            GlobalVarDecl* item = bootstrap_as_global_var_decl(declaration)
            SemanticType* sem = resolve_ref(lowerer, item.Type)
            string name = sanitize_llvm_name(item.Name)
            ir_local local; local.address = "@" + name; local.type_info = sem
            lowerer.globals[item.Name] = local
            string initial = constant_initializer(lowerer, item.Initializer, sem)
            int64 n = lowerer.global_defs.length
            lowerer.global_defs = array<string>(lowerer.global_defs, n + 1)
            lowerer.global_defs[n] = "@" + name + " = global " + llvm_type(lowerer, sem) + " " + initial
        } else if declaration.kind == DECL_ENUM {
            EnumDecl* item = bootstrap_as_enum_decl(declaration)
            Map<string, int64> values = Map<string, int64>()
            int64 next = 0
            int64 member_index = 0
            while member_index < item.Members.length {
                EnumMember* member = item.Members[member_index]
                if member.Value.kind == EXPR_LITERAL && member.Value.literal != null && member.Value.literal.Kind == "integer" {
                    BootstrapIntegerResult parsed = parse_integer_literal(member.Value.literal.Raw)
                    if parsed.ok { next = parsed.value }
                }
                values[member.Name] = next
                next += 1
                member_index += 1
            }
            lowerer.enum_values[item.Name] = values
        }
        declaration_index += 1
    }
}

void install_builtin_error_struct(llvm_lowerer* lowerer) {
    if lowerer.struct_info["Error"] != null { return }
    StructInfo* info = new StructInfo(); info.name="Error"; info.fields=Map<string, Symbol*>(); info.methods=Map<string, Symbol*>(); info.field_order = array<string>(info.field_order, 3); info.field_order[0]="error"; info.field_order[1]="error_type"; info.field_order[2]="error_message"
    Symbol* error_field=new Symbol(); error_field.name="error"; error_field.kind="field"; error_field.type_info=new SemanticType(); error_field.type_info.kind="bool"; error_field.type_info.name="bool"; info.fields["error"]=error_field
    Symbol* type_field=new Symbol(); type_field.name="error_type"; type_field.kind="field"; type_field.type_info=new SemanticType(); type_field.type_info.kind="error_type"; type_field.type_info.name="ErrorType"; info.fields["error_type"]=type_field
    Symbol* message_field=new Symbol(); message_field.name="error_message"; message_field.kind="field"; message_field.type_info=new SemanticType(); message_field.type_info.kind="string"; message_field.type_info.name="string"; info.fields["error_message"]=message_field
    SemanticCallable* ctor=new SemanticCallable(); ctor.return_type=new SemanticType(); ctor.return_type.kind="struct"; ctor.return_type.name="Error"; ctor.parameters = array<SemanticType*>(ctor.parameters, 1); ctor.parameters[0]=new SemanticType(); ctor.parameters[0].kind="bool"; ctor.parameters[0].name="bool"; info.constructors = array<SemanticCallable*>(info.constructors, 1); info.constructors[0]=ctor
    lowerer.struct_info["Error"]=info
}

void emit_top_level(llvm_lowerer* lowerer) {
    int64 i=0
    while i<lowerer.program.Declarations.length {
        Decl declaration=lowerer.program.Declarations[i]
        if declaration.kind==DECL_FUNCTION { FunctionDecl* item=bootstrap_as_function_decl(declaration); if item!=null && item.Body!=null && !item.Extern {emit_function(lowerer,item,null)} }
        else if declaration.kind==DECL_STRUCT {
            StructDecl* item=bootstrap_as_struct_decl(declaration); StructInfo* struct_template=lowerer.struct_info[item.Name]
            if item.GenericParameters.length==0 { emit_struct_declaration(lowerer,item,struct_template,Map<string, SemanticType*>()) }
            else { GenericSpecialization[] specs=requested_specializations(lowerer,item.Name); int64 j=0; while j<specs.length { string concrete_name=specialization_name(item.Name,specs[j].type_arguments); StructInfo* concrete=lowerer.struct_info[concrete_name]; if concrete==null {concrete=specialized_struct_info(struct_template,specs[j].type_arguments); if concrete!=null {lowerer.struct_info[concrete.name]=concrete}}; if concrete!=null {emit_struct_declaration(lowerer,item,concrete,build_substitutions(struct_template.generic_parameters,specs[j].type_arguments))}; j+=1 } }
        } else if declaration.kind==DECL_METHOD_BLOCK { MethodBlockDecl* item=bootstrap_as_method_block_decl(declaration); StructInfo* info=lowerer.struct_info[item.Receiver.Name]; int64 j=0; while j<item.Members.length { if item.Members[j].kind==MEMBER_METHOD {MethodDecl* method=bootstrap_as_method_decl(item.Members[j]); emit_function(lowerer,&method.Function,info)}; j+=1 } }
        i+=1
    }
}

void emit_struct_declaration(llvm_lowerer* lowerer, StructDecl* item, StructInfo* info, Map<string, SemanticType*> substitutions) {
    if info==null {return}; Map<string, SemanticType*> saved=lowerer.substitutions; lowerer.substitutions=substitutions; bool has_constructor=false; int64 i=0
    while i<item.Members.length { StructMember member=item.Members[i]; if member.kind==MEMBER_METHOD {MethodDecl* method=bootstrap_as_method_decl(member); emit_function(lowerer,&method.Function,info)} else if member.kind==MEMBER_CONSTRUCTOR {ConstructorMember* ctor=bootstrap_as_constructor_member(member); has_constructor=true; emit_constructor(lowerer,info.name,&ctor.Constructor,info)} else if member.kind==MEMBER_DESTRUCTOR {DestructorMember* dtor=bootstrap_as_destructor_member(member); emit_destructor(lowerer,info.name,&dtor.Destructor,info)}; i+=1 }
    if !has_constructor {emit_default_constructor(lowerer,info.name)}; lowerer.substitutions=saved
}

string llvm_function_name(FunctionDecl* function) {
    if function == null { return "anonymous" }
    if function.Receiver != "" { return llvm_method_name(function.Receiver, function.Name) }
    return sanitize_llvm_name(function.Name)
}

string llvm_method_name(string receiver, string method) { return sanitize_llvm_name(receiver + "__" + method) }

string llvm_constructor_name(string name) { return sanitize_llvm_name(name + "__ctor") }
string llvm_destructor_name(string name) { return sanitize_llvm_name(name + "__dtor") }

string sanitize_llvm_name(string name) {
    string output = ""
    int64 i = 0
    while i < bootstrap_string_length(name) {
        string ch = bootstrap_string_slice(name, i, 1)
        bool valid = (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") || (ch >= "0" && ch <= "9") || ch == "_" || ch == "."
        if valid { output = output + ch } else { output = output + "_" }
        i += 1
    }
    if output == "" { return "anonymous" }
    return output
}

SemanticType* variadic_parameter_type(llvm_lowerer* lowerer, Parameter* parameter) {
    if parameter == null || parameter.Type == null { SemanticType* unknown = new SemanticType(); unknown.kind = "unknown"; return unknown }
    if parameter.Type.Name == "auto" {
        SemanticType* result = new SemanticType(); result.kind = "array"; result.name = "auto_variadic"
        result.array_dimensions = array<SemanticArrayDimension>(result.array_dimensions, 1); result.array_dimensions[0].dynamic = true
        return result
    }
    SemanticType* element = resolve_ref(lowerer, parameter.Type)
    SemanticType* array = clone_type(element); array.kind = "array"
    array.array_dimensions = array<SemanticArrayDimension>(array.array_dimensions, 1); array.array_dimensions[0].dynamic = true
    return array
}

int64 bootstrap_decimal_int(string text) { int64 value=0; int64 i=0; while i<bootstrap_string_length(text) { string ch=bootstrap_string_slice(text,i,1); if ch>="0" && ch<="9" { value=value*10; if ch=="1" {value+=1} else if ch=="2" {value+=2} else if ch=="3" {value+=3} else if ch=="4" {value+=4} else if ch=="5" {value+=5} else if ch=="6" {value+=6} else if ch=="7" {value+=7} else if ch=="8" {value+=8} else if ch=="9" {value+=9} }; i+=1 }; return value }

string join_llvm_strings(string[] values, string separator) { string result=""; int64 i=0; while i<values.length {if i>0 {result=result+separator}; result=result+values[i]; i+=1}; return result }
string function_declaration(llvm_lowerer* lowerer, FunctionDecl* function) {
    string[] parameters
    if function.Receiver!="" {parameters = array<string>(parameters, 1); parameters[0]="ptr"}
    bool native_variadic=false; int64 i=0
    while i<function.Parameters.length { Parameter* parameter=function.Parameters[i]; if parameter.Variadic {if parameter.Type!=null {auto n=parameters.length; parameters = array<string>(parameters, n+1); parameters[n]="ptr"} else {native_variadic=true}} else {auto n=parameters.length; parameters = array<string>(parameters, n+1); parameters[n]=llvm_type_from_ref(lowerer,parameter.Type)}; i+=1 }
    if native_variadic {auto n=parameters.length; parameters = array<string>(parameters, n+1); parameters[n]="..."}
    return "declare "+llvm_type_from_ref(lowerer,function.ReturnType)+" @"+llvm_function_name(function)+"("+join_llvm_strings(parameters,", ")+")"
}

string llvm_type_from_ref(llvm_lowerer* lowerer, TypeRef* ref) { return llvm_type(lowerer, resolve_ref(lowerer, ref)) }

string llvm_type(llvm_lowerer* lowerer, SemanticType* type_info) {
    if type_info == null { return "ptr" }
    if type_info.pointer_depth > 0 || type_info.array_dimensions.length > 0 || type_info.callable != null { return "ptr" }
    if type_info.kind == "void" { return "void" }
    if type_info.kind == "bool" { return "i1" }
    if type_info.kind == "string" || type_info.kind == "struct" || type_info.kind == "protocol" || type_info.kind == "namespace" || type_info.kind == "pointer" || type_info.kind == "array" || type_info.kind == "callable" || type_info.kind == "null" { return "ptr" }
    if type_info.kind == "char" { return "i8" }
    if type_info.kind == "float" { if type_info.name == "float32" { return "float" }; return "double" }
    if type_info.kind == "enum" || type_info.kind == "error_type" { return "i32" }
    if type_info.kind == "integer" {
        if type_info.name == "int8" || type_info.name == "uint8" { return "i8" }
        if type_info.name == "int16" || type_info.name == "uint16" { return "i16" }
        if type_info.name == "int32" || type_info.name == "uint32" { return "i32" }
        return "i64"
    }
    if type_info.name == "void" { return "void" }; if type_info.name == "bool" { return "i1" }; if type_info.name == "char" { return "i8" }
    if type_info.name == "int8" || type_info.name == "uint8" { return "i8" }; if type_info.name == "int16" || type_info.name == "uint16" { return "i16" }; if type_info.name == "int32" || type_info.name == "uint32" { return "i32" }
    if type_info.name == "int64" || type_info.name == "uint64" || type_info.name == "uintptr" { return "i64" }; if type_info.name == "float32" { return "float" }; if type_info.name == "float64" { return "double" }
    return "ptr"
}

string next_register(llvm_lowerer* lowerer) { lowerer.register += 1; return "%v" + `${lowerer.register}` }
string next_label(llvm_lowerer* lowerer, string prefix) { lowerer.label += 1; return prefix + "." + `${lowerer.label}` }
void line(llvm_lowerer* lowerer, string format, string[] args) {
    string text = format
    int64 arg_index = 0
    while arg_index < args.length {
        int64 at = -1
        int64 i = 0
        int64 n = bootstrap_string_length(text)
        while i + 1 < n {
            if bootstrap_string_slice(text, i, 2) == "{}" { at = i; break }
            i += 1
        }
        if at < 0 { break }
        text = bootstrap_string_slice(text, 0, at) + args[arg_index] + bootstrap_string_slice(text, at + 2, n - at - 2)
        arg_index += 1
    }
    raw_line(lowerer, "  " + text)
}
void raw_line(llvm_lowerer* lowerer, string text) {
    int64 n = lowerer.current_lines.length
    lowerer.current_lines = array<string>(lowerer.current_lines, n + 1)
    lowerer.current_lines[n] = text
    if bootstrap_string_length(text) > 0 && bootstrap_string_slice(text, bootstrap_string_length(text) - 1, 1) == ":" {
        lowerer.current_block = bootstrap_string_slice(text, 0, bootstrap_string_length(text) - 1)
    }
}

void emit_function(llvm_lowerer* lowerer, FunctionDecl* function, StructInfo* receiver) {
    lowerer.register=0; lowerer.label=0; lowerer.current_lines = array<string>(lowerer.current_lines, 0); lowerer.locals=Map<string, ir_local>()
    lowerer.break_labels = array<string>(lowerer.break_labels, 0); lowerer.continue_labels = array<string>(lowerer.continue_labels, 0); lowerer.break_cleanup_depths = array<int64>(lowerer.break_cleanup_depths, 0); lowerer.continue_cleanup_depths = array<int64>(lowerer.continue_cleanup_depths, 0); lowerer.receiver=receiver
    SemanticType* return_sem=resolve_ref(lowerer,function.ReturnType); lowerer.return_type=return_sem; string[] parameters; lowerer.main_args_name=""; lowerer.main_argc_value=""
    bool main_argv=function.Name=="main"&&function.Receiver==""&&function.Parameters.length==1&&function.Parameters[0].Type!=null&&function.Parameters[0].Type.Name=="string"&&function.Parameters[0].Type.Arrays.length>0
    if receiver!=null||function.Receiver!="" {parameters = array<string>(parameters, 1); parameters[0]="ptr %arg.this"}
    if main_argv {int64 n=parameters.length; parameters = array<string>(parameters, n+2); parameters[n]="i32 %clyth.argc"; parameters[n+1]="ptr %clyth.argv"; lowerer.main_args_name=function.Parameters[0].Name; lowerer.main_argc_value="%clyth.argc"}
    else {int64 i=0; while i<function.Parameters.length {Parameter* parameter=function.Parameters[i]; if parameter.Variadic {if parameter.Type!=null {int64 n=parameters.length; parameters = array<string>(parameters, n+1); parameters[n]=`ptr %arg.${i}`}; i+=1; continue}; int64 n=parameters.length; parameters = array<string>(parameters, n+1); parameters[n]=llvm_type_from_ref(lowerer,parameter.Type)+` %arg.${i}`; i+=1}}
    string function_name=llvm_function_name(function); if receiver!=null {function_name=llvm_method_name(receiver.name,function.Name)}
    raw_line(lowerer,"define "+llvm_type_from_ref(lowerer,function.ReturnType)+" @"+function_name+"("+join_llvm_strings(parameters,", ")+") {"); raw_line(lowerer,"entry:")
    lowerer.cleanup_slots=Map<int64, string>(); lowerer.mecc_root_scopes = array<string[]>(lowerer.mecc_root_scopes, 0); lowerer.value_cleanup_scopes = array<value_cleanup[]>(lowerer.value_cleanup_scopes, 0); lowerer.pending_parameter_cleanups = array<value_cleanup>(lowerer.pending_parameter_cleanups, 0); prepare_cleanup_slots(lowerer,function.Body.node)
    if receiver!=null||function.Receiver!="" {ir_local local; local.address="%arg.this"; local.type_info=new SemanticType(); local.type_info.kind="struct"; local.type_info.name=receiver_name(receiver,function); lowerer.locals["this"]=local}
    int64 i=0
    while i<function.Parameters.length {Parameter* parameter=function.Parameters[i]; if parameter.Variadic&&parameter.Type==null {i+=1; continue}; SemanticType* sem=resolve_ref(lowerer,parameter.Type); if parameter.Variadic {sem=variadic_parameter_type(lowerer,parameter)}; string ty=llvm_type(lowerer,sem); string address=next_register(lowerer); raw_line(lowerer,`  ${address} = alloca ${ty}`)
        if main_argv {
            // Native argv is char**. Clyth string[] must contain pointers to
            // Core string descriptors, never the raw C char* values. Build a
            // stack-resident descriptor for every process argument and point
            // the Clyth array at those descriptors for main's entire lifetime.
            string argc64=next_register(lowerer); raw_line(lowerer,`  ${argc64} = sext i32 %clyth.argc to i64`)
            string data=next_register(lowerer); raw_line(lowerer,`  ${data} = alloca ptr, i64 ${argc64}`)
            string descriptor_bytes=next_register(lowerer); raw_line(lowerer,`  ${descriptor_bytes} = mul i64 ${argc64}, 32`)
            string descriptors=next_register(lowerer); raw_line(lowerer,`  ${descriptors} = alloca i8, i64 ${descriptor_bytes}`)
            string index_slot=next_register(lowerer); raw_line(lowerer,`  ${index_slot} = alloca i64`); raw_line(lowerer,`  store i64 0, ptr ${index_slot}`)
            string cond=next_label(lowerer,"main.argv.cond"); string body=next_label(lowerer,"main.argv.body"); string done=next_label(lowerer,"main.argv.done")
            raw_line(lowerer,`  br label %${cond}`); raw_line(lowerer,cond+":")
            string index=next_register(lowerer); raw_line(lowerer,`  ${index} = load i64, ptr ${index_slot}`)
            string more=next_register(lowerer); raw_line(lowerer,`  ${more} = icmp ult i64 ${index}, ${argc64}`); raw_line(lowerer,`  br i1 ${more}, label %${body}, label %${done}`); raw_line(lowerer,body+":")
            string raw_slot=next_register(lowerer); raw_line(lowerer,`  ${raw_slot} = getelementptr ptr, ptr %clyth.argv, i64 ${index}`)
            string raw=next_register(lowerer); raw_line(lowerer,`  ${raw} = load ptr, ptr ${raw_slot}`)
            string descriptor_offset=next_register(lowerer); raw_line(lowerer,`  ${descriptor_offset} = mul i64 ${index}, 32`)
            string descriptor=next_register(lowerer); raw_line(lowerer,`  ${descriptor} = getelementptr i8, ptr ${descriptors}, i64 ${descriptor_offset}`)
            // Core string ABI: array_ptr @ +0, local_stack_cache @ +8 (zeroed
            // here), local_stack_cache_size @ +16, length @ +24.
            string heap_slot=next_register(lowerer); raw_line(lowerer,`  ${heap_slot} = getelementptr i8, ptr ${descriptor}, i64 0`); raw_line(lowerer,`  store ptr ${raw}, ptr ${heap_slot}`)
            string cache_slot=next_register(lowerer); raw_line(lowerer,`  ${cache_slot} = getelementptr i8, ptr ${descriptor}, i64 8`); raw_line(lowerer,`  store i64 0, ptr ${cache_slot}`)
            string cache_size_slot=next_register(lowerer); raw_line(lowerer,`  ${cache_size_slot} = getelementptr i8, ptr ${descriptor}, i64 16`); raw_line(lowerer,`  store i64 0, ptr ${cache_size_slot}`)
            string raw_length=next_register(lowerer); raw_line(lowerer,`  ${raw_length} = call i64 @strlen(ptr ${raw})`)
            string string_length_slot=next_register(lowerer); raw_line(lowerer,`  ${string_length_slot} = getelementptr i8, ptr ${descriptor}, i64 24`); raw_line(lowerer,`  store i64 ${raw_length}, ptr ${string_length_slot}`)
            string data_element=next_register(lowerer); raw_line(lowerer,`  ${data_element} = getelementptr ptr, ptr ${data}, i64 ${index}`); raw_line(lowerer,`  store ptr ${descriptor}, ptr ${data_element}`)
            string next=next_register(lowerer); raw_line(lowerer,`  ${next} = add i64 ${index}, 1`); raw_line(lowerer,`  store i64 ${next}, ptr ${index_slot}`); raw_line(lowerer,`  br label %${cond}`); raw_line(lowerer,done+":")
            string header=emit_stack_array_header(lowerer,data,0)
            string length_slot=next_register(lowerer); raw_line(lowerer,`  ${length_slot} = getelementptr i8, ptr ${header}, i64 8`); raw_line(lowerer,`  store i64 ${argc64}, ptr ${length_slot}`); raw_line(lowerer,`  store ptr ${header}, ptr ${address}`)
        }
        else if is_value_aggregate(sem) {
            IRValue incoming; incoming.llvm_type=ty; incoming.value=`%arg.${i}`; incoming.type_info=sem
            IRValue owned
            if sem.kind=="struct" && sem.pointer_depth==0 { owned=clone_struct_value(lowerer,incoming,sem) }
            else { owned=clone_array_value(lowerer,incoming,sem) }
            raw_line(lowerer,`  store ${ty} ${owned.value}, ptr ${address}`)
            int64 cleanup_n=lowerer.pending_parameter_cleanups.length; lowerer.pending_parameter_cleanups=array<value_cleanup>(lowerer.pending_parameter_cleanups,cleanup_n+1); value_cleanup cleanup; cleanup.address=address; cleanup.type_info=sem; lowerer.pending_parameter_cleanups[cleanup_n]=cleanup
        }
        else {raw_line(lowerer,`  store ${ty} %arg.${i}, ptr ${address}`)}
        ir_local local; local.address=address; local.type_info=sem; lowerer.locals[parameter.Name]=local; i+=1
    }
    bool terminated=emit_block(lowerer,function.Body); if !terminated {emit_default_return(lowerer,return_sem)}; raw_line(lowerer,"}")
    int64 n=lowerer.function_defs.length; lowerer.function_defs = array<string>(lowerer.function_defs, n+1); lowerer.function_defs[n]=join_llvm_strings(lowerer.current_lines,"\n")
}

string receiver_name(StructInfo* receiver, FunctionDecl* function) { if receiver != null { return receiver.name }; if function != null { return function.Receiver }; return "" }

void emit_constructor(llvm_lowerer* lowerer, string name, ConstructorDecl* ctor, StructInfo* info) {
    lowerer.register = 0; lowerer.label = 0; lowerer.current_lines = array<string>(lowerer.current_lines, 0); lowerer.locals = Map<string, ir_local>()
    lowerer.break_labels = array<string>(lowerer.break_labels, 0); lowerer.continue_labels = array<string>(lowerer.continue_labels, 0); lowerer.break_cleanup_depths = array<int64>(lowerer.break_cleanup_depths, 0); lowerer.continue_cleanup_depths = array<int64>(lowerer.continue_cleanup_depths, 0)
    lowerer.receiver = info
    lowerer.return_type = new SemanticType(); lowerer.return_type.kind = "struct"; lowerer.return_type.name = name; lowerer.return_type.pointer_depth = 1
    string[] parameters
    int64 i = 0
    while i < ctor.Parameters.length {
        string entry = llvm_type_from_ref(lowerer, ctor.Parameters[i].Type) + " %arg." + `${i}`
        int64 n = parameters.length; parameters = array<string>(parameters, n + 1); parameters[n] = entry
        i += 1
    }
    raw_line(lowerer, "define ptr @" + llvm_constructor_name(name) + "(" + join_llvm_strings(parameters, ", ") + ") {")
    raw_line(lowerer, "entry:")
    lowerer.cleanup_slots = Map<int64, string>(); lowerer.mecc_root_scopes = array<string[]>(lowerer.mecc_root_scopes, 0); lowerer.value_cleanup_scopes = array<value_cleanup[]>(lowerer.value_cleanup_scopes, 0)
    prepare_cleanup_slots(lowerer, ctor.Body.node)
    string object = next_register(lowerer)
    raw_line(lowerer, `  ${object} = call ptr @calloc(i64 1, i64 ${struct_storage_size(lowerer, info)})`)
    initialize_struct_fields(lowerer, object, info)
    ir_local this_local; this_local.address = object; this_local.type_info = new SemanticType(); this_local.type_info.kind = "struct"; this_local.type_info.name = name; lowerer.locals["this"] = this_local
    i = 0
    while i < ctor.Parameters.length {
        SemanticType* sem = resolve_ref(lowerer, ctor.Parameters[i].Type); string ty = llvm_type(lowerer, sem); string address = next_register(lowerer)
        raw_line(lowerer, `  ${address} = alloca ${ty}`); raw_line(lowerer, `  store ${ty} %arg.${i}, ptr ${address}`)
        ir_local local; local.address = address; local.type_info = sem; lowerer.locals[ctor.Parameters[i].Name] = local
        i += 1
    }
    emit_block(lowerer, ctor.Body)
    emit_mecc_clear_all_roots(lowerer)
    raw_line(lowerer, `  ret ptr ${object}`); raw_line(lowerer, "}")
    int64 n = lowerer.function_defs.length; lowerer.function_defs = array<string>(lowerer.function_defs, n + 1); lowerer.function_defs[n] = join_llvm_strings(lowerer.current_lines, "\n")
}

void emit_destructor(llvm_lowerer* lowerer, string name, DestructorDecl* destructor, StructInfo* info) {
    lowerer.register = 0; lowerer.label = 0; lowerer.current_lines = array<string>(lowerer.current_lines, 0); lowerer.locals = Map<string, ir_local>(); lowerer.cleanup_slots = Map<int64, string>()
    lowerer.mecc_root_scopes = array<string[]>(lowerer.mecc_root_scopes, 0); lowerer.value_cleanup_scopes = array<value_cleanup[]>(lowerer.value_cleanup_scopes, 0); lowerer.receiver = info
    lowerer.return_type = new SemanticType(); lowerer.return_type.kind = "void"; lowerer.return_type.name = "void"
    raw_line(lowerer, "define void @" + llvm_destructor_name(name) + "(ptr %arg.this) {"); raw_line(lowerer, "entry:")
    prepare_cleanup_slots(lowerer, destructor.Body.node)
    ir_local this_local; this_local.address = "%arg.this"; this_local.type_info = new SemanticType(); this_local.type_info.kind = "struct"; this_local.type_info.name = name; lowerer.locals["this"] = this_local
    bool terminated = emit_block(lowerer, destructor.Body)
    if !terminated { emit_mecc_function_frontier(lowerer); raw_line(lowerer, "  ret void") }
    raw_line(lowerer, "}")
    int64 n = lowerer.function_defs.length; lowerer.function_defs = array<string>(lowerer.function_defs, n + 1); lowerer.function_defs[n] = join_llvm_strings(lowerer.current_lines, "\n")
}

void emit_default_constructor(llvm_lowerer* lowerer, string name) {
    string fn = llvm_constructor_name(name)
    if lowerer.defined[fn] { return }
    lowerer.defined[fn] = true
    StructInfo* info = lowerer.struct_info[name]
    lowerer.register = 0; lowerer.label = 0; lowerer.current_lines = array<string>(lowerer.current_lines, 0)
    raw_line(lowerer, "define ptr @" + fn + "() {"); raw_line(lowerer, "entry:")
    string object = next_register(lowerer)
    raw_line(lowerer, `  ${object} = call ptr @calloc(i64 1, i64 ${struct_storage_size(lowerer, info)})`)
    initialize_struct_fields(lowerer, object, info); raw_line(lowerer, `  ret ptr ${object}`); raw_line(lowerer, "}")
    int64 n = lowerer.function_defs.length; lowerer.function_defs = array<string>(lowerer.function_defs, n + 1); lowerer.function_defs[n] = join_llvm_strings(lowerer.current_lines, "\n")
}

Symbol* lookup_type_symbol(llvm_lowerer* lowerer, Namespace* namespace, string name, Map<Namespace*, bool> seen) {
    if namespace == null || seen[namespace] { return null }
    seen[namespace] = true
    Symbol* symbol = namespace.symbols[name]
    if symbol != null { return symbol }
    int64 i = 0
    while i < namespace.open_imports.length {
        Symbol* found = lookup_type_symbol(lowerer, namespace.open_imports[i], name, seen)
        if found != null { return found }
        i += 1
    }
    return null
}

bool enum_member_value(Symbol* symbol, string member_name, int64* value) {
    if symbol == null || symbol.type_info == null || symbol.type_info.kind != "enum" { return false }
    if symbol.declaration.category != NODE_DECL || symbol.declaration.declaration.kind != DECL_ENUM { return false }
    EnumDecl* declaration = symbol.declaration.declaration.enum_decl
    if declaration == null { return false }
    int64 next = 0
    int64 i = 0
    while i < declaration.Members.length {
        EnumMember* member = declaration.Members[i]
        if member != null && member.Value.kind == EXPR_LITERAL && member.Value.literal != null && member.Value.literal.Kind == "integer" {
            BootstrapIntegerResult parsed = parse_integer_literal(member.Value.literal.Raw)
            if parsed.ok { next = parsed.value }
        }
        if member != null && member.Name == member_name { value[0] = next; return true }
        next += 1
        i += 1
    }
    return false
}

SemanticType* resolve_ref(llvm_lowerer* lowerer, TypeRef* ref) {
    if ref == null { SemanticType* unknown = new SemanticType(); unknown.kind = "unknown"; return unknown }
    SemanticType* replacement = lowerer.substitutions[ref.Name]
    if replacement != null {
        SemanticType* result = clone_type(replacement); result.pointer_depth += ref.PointerDepth; result.is_const = result.is_const || ref.Const
        int64 i = 0; while i < ref.Arrays.length { SemanticArrayDimension dim; dim.dynamic = ref.Arrays[i].Dynamic; dim.size = array_dimension_size(ref.Arrays[i]); auto n=result.array_dimensions.length; result.array_dimensions = array<SemanticArrayDimension>(result.array_dimensions, n+1); result.array_dimensions[n]=dim; i += 1 }
        if result.array_dimensions.length > 0 { result.kind = "array" } else if result.pointer_depth > 0 { result.kind = "pointer" }; return result
    }
    SemanticType* result = new SemanticType(); result.name = ref.Name; result.pointer_depth = ref.PointerDepth; result.is_const = ref.Const
    int64 i = 0; while i < ref.GenericArgs.length { auto n=result.generic_args.length; result.generic_args = array<SemanticType*>(result.generic_args, n+1); result.generic_args[n]=resolve_ref(lowerer,ref.GenericArgs[i]); i+=1 }
    if ref.Name == "void" { result.kind="void" } else if ref.Name == "bool" { result.kind="bool" } else if ref.Name == "char" { result.kind="char" } else if ref.Name == "string" { result.kind="string" } else if ref.Name == "float32" || ref.Name == "float64" { result.kind="float" } else if ref.Name == "int8" || ref.Name == "int16" || ref.Name == "int32" || ref.Name == "int64" || ref.Name == "uint8" || ref.Name == "uint16" || ref.Name == "uint32" || ref.Name == "uint64" || ref.Name == "uintptr" { result.kind="integer" } else if lowerer.enum_values[ref.Name].length > 0 { result.kind="enum" } else {
        Symbol* imported = lookup_type_symbol(lowerer, lowerer.result.root_namespace, ref.Name, Map<Namespace*, bool>())
        if imported != null && imported.type_info != null && imported.type_info.kind == "enum" { result.kind="enum" } else { result.kind="struct" }
    }
    i=0; while i<ref.Arrays.length { SemanticArrayDimension dim; dim.dynamic=ref.Arrays[i].Dynamic; dim.size=array_dimension_size(ref.Arrays[i]); auto n=result.array_dimensions.length; result.array_dimensions = array<SemanticArrayDimension>(result.array_dimensions, n+1); result.array_dimensions[n]=dim; i+=1 }
    if ref.PointerDepth>0 { result.kind="pointer" }; if ref.Arrays.length>0 { result.kind="array" }
    if ref.Callable != null { result.kind="callable"; SemanticCallable* callable=new SemanticCallable(); callable.return_type=resolve_ref(lowerer,ref.Callable.Return); i=0; while i<ref.Callable.Parameters.length { auto n=callable.parameters.length; callable.parameters = array<SemanticType*>(callable.parameters, n+1); callable.parameters[n]=resolve_ref(lowerer,ref.Callable.Parameters[i]); i+=1 }; callable.variadic=ref.Callable.Variadic; result.callable=callable }
    return result
}

string array_dimension_size(ArrayDimension dimension) { if dimension.Dynamic || dimension.Size.kind == 0 { return "" }; if dimension.Size.kind == EXPR_LITERAL && dimension.Size.literal != null { return dimension.Size.literal.Raw }; return "" }

SemanticType* specialize_type(llvm_lowerer* lowerer, SemanticType* type_info) {
    if type_info == null { return null }; SemanticType* result=clone_type(type_info); SemanticType* replacement=lowerer.substitutions[result.name]
    if replacement != null { SemanticType* base=clone_type(replacement); base.pointer_depth += result.pointer_depth; int64 old=base.array_dimensions.length; base.array_dimensions = array<SemanticArrayDimension>(base.array_dimensions, old+result.array_dimensions.length); int64 i=0; while i<result.array_dimensions.length { base.array_dimensions[old+i]=result.array_dimensions[i]; i+=1 }; base.is_const=base.is_const||result.is_const; if base.array_dimensions.length>0 {base.kind="array"} else if base.pointer_depth>0 {base.kind="pointer"}; return base }
    int64 i=0; while i<result.generic_args.length { result.generic_args[i]=specialize_type(lowerer,result.generic_args[i]); i+=1 }; if result.callable!=null { result.callable.return_type=specialize_type(lowerer,result.callable.return_type); i=0; while i<result.callable.parameters.length {result.callable.parameters[i]=specialize_type(lowerer,result.callable.parameters[i]); i+=1} }; return result
}

StructInfo* specialized_struct_info(StructInfo* template, SemanticType*[] arguments) {
    if template==null {return null}; Map<string, SemanticType*> substitutions=build_substitutions(template.generic_parameters,arguments); StructInfo* info=new StructInfo(); info.name=specialization_name(template.name,arguments); info.declaration=template.declaration; info.fields=Map<string, Symbol*>(); info.methods=Map<string, Symbol*>(); info.constructors=template.constructors; info.destructor=template.destructor
    info.field_order = array<string>(info.field_order, template.field_order.length); int64 i=0; while i<template.field_order.length {info.field_order[i]=template.field_order[i]; i+=1}
    string[] names=template.fields.keys(); i=0; while i<names.length {Symbol* source=template.fields[names[i]]; if source!=null {Symbol* copy=new Symbol(); copy.name=source.name; copy.kind=source.kind; copy.type_info=substitute_type(source.type_info,substitutions); copy.declaration=source.declaration; copy.namespace_name=source.namespace_name; copy.scope_id=source.scope_id; copy.generic_parameters=source.generic_parameters; copy.receiver_name=source.receiver_name; copy.error_type_id=source.error_type_id; info.fields[names[i]]=copy}; i+=1}
    names=template.methods.keys(); i=0; while i<names.length {Symbol* source=template.methods[names[i]]; if source!=null {Symbol* copy=new Symbol(); copy.name=source.name; copy.kind=source.kind; copy.type_info=substitute_type(source.type_info,substitutions); copy.declaration=source.declaration; copy.namespace_name=source.namespace_name; copy.scope_id=source.scope_id; copy.generic_parameters=source.generic_parameters; copy.receiver_name=source.receiver_name; copy.error_type_id=source.error_type_id; info.methods[names[i]]=copy}; i+=1}; return info
}

IRValue default_array_value(llvm_lowerer* lowerer, SemanticType* type_info) {
    int64 count = 0
    if type_info != null && type_info.array_dimensions.length > 0 && !type_info.array_dimensions[0].dynamic { count = bootstrap_decimal_int(type_info.array_dimensions[0].size) }
    SemanticType* element = array_element_type(lowerer, type_info)
    int64 element_size = semantic_storage_size(lowerer, element)
    string header = next_register(lowerer)
    raw_line(lowerer, `  ${header} = call ptr @calloc(i64 1, i64 16)`)
    if count > 0 {
        string data = next_register(lowerer)
        raw_line(lowerer, `  ${data} = call ptr @calloc(i64 ${count}, i64 ${element_size})`)
        string data_slot = next_register(lowerer)
        raw_line(lowerer, `  ${data_slot} = getelementptr i8, ptr ${header}, i64 0`)
        raw_line(lowerer, `  store ptr ${data}, ptr ${data_slot}`)
    }
    string length_slot = next_register(lowerer)
    raw_line(lowerer, `  ${length_slot} = getelementptr i8, ptr ${header}, i64 8`)
    raw_line(lowerer, `  store i64 ${count}, ptr ${length_slot}`)
    IRValue result; result.llvm_type="ptr"; result.value=header; result.type_info=type_info; result.fresh=true; return result
}

bool constructor_accepts_no_explicit_arguments(SemanticCallable* ctor) {
    if ctor == null { return true }
    int64 fixed = ctor.parameters.length
    if ctor.variadic && !ctor.native_variadic && fixed > 0 { fixed -= 1 }
    int64 i = 0
    while i < fixed {
        if i >= ctor.default_values.length || ctor.default_values[i].kind == 0 { return false }
        i += 1
    }
    return true
}

IRValue default_struct_value(llvm_lowerer* lowerer, SemanticType* type_info) {
    string name = base_type_name(type_info); StructInfo* info = lowerer.struct_info[name]
    if info == null { return zero_value(lowerer, type_info) }
    bool can_call_default = info.constructors.length == 0; int64 i=0
    while i < info.constructors.length { SemanticCallable* ctor=info.constructors[i]; if ctor!=null && ctor.parameters.length==0 && !ctor.variadic {can_call_default=true; break}; i+=1 }
    if can_call_default {
        string fn=llvm_constructor_name(name); if !lowerer.defined[fn] && lowerer.declarations[fn]=="" {lowerer.declarations[fn]=`declare ptr @${fn}()`}
        string value=next_register(lowerer); raw_line(lowerer, `  ${value} = call ptr @${fn}()`); IRValue result; result.llvm_type="ptr"; result.value=value; result.type_info=type_info; result.fresh=true; return result
    }
    string value=next_register(lowerer); int64 size=struct_storage_size(lowerer,info); raw_line(lowerer, `  ${value} = call ptr @calloc(i64 1, i64 ${size})`); initialize_struct_fields(lowerer,value,info)
    IRValue result; result.llvm_type="ptr"; result.value=value; result.type_info=type_info; result.fresh=true; return result
}

bool emit_block(llvm_lowerer* lowerer, BlockStmt* block) {
    if block == null { return false }
    Map<string, ir_local> saved_locals = Map<string, ir_local>()
    string[] local_names = lowerer.locals.keys(); int64 i = 0
    while i < local_names.length { saved_locals[local_names[i]] = lowerer.locals[local_names[i]]; i += 1 }
    int64 old_block_depth = lowerer.block_stack.length
    int64 old_mecc_depth = lowerer.mecc_root_scopes.length
    int64 old_value_depth = lowerer.value_cleanup_scopes.length
    lowerer.block_stack = array<BlockStmt*>(lowerer.block_stack, old_block_depth + 1); lowerer.block_stack[old_block_depth] = block
    lowerer.mecc_root_scopes = array<string[]>(lowerer.mecc_root_scopes, old_mecc_depth + 1); lowerer.mecc_root_scopes[old_mecc_depth] = array<string>(lowerer.mecc_root_scopes[old_mecc_depth], 0)
    lowerer.value_cleanup_scopes = array<value_cleanup[]>(lowerer.value_cleanup_scopes, old_value_depth + 1)
    if old_value_depth==0 && lowerer.pending_parameter_cleanups.length>0 { lowerer.value_cleanup_scopes[old_value_depth]=lowerer.pending_parameter_cleanups; lowerer.pending_parameter_cleanups=array<value_cleanup>(lowerer.pending_parameter_cleanups,0) }
    else { lowerer.value_cleanup_scopes[old_value_depth] = array<value_cleanup>(lowerer.value_cleanup_scopes[old_value_depth], 0) }
    bool terminated = false; i = 0
    while i < block.Statements.length {
        if emit_stmt(lowerer, block.Statements[i]) { terminated = true; break }
        i += 1
    }
    if !terminated {
        emit_value_cleanup_scope(lowerer, lowerer.value_cleanup_scopes.length - 1)
        emit_lifetime_cleanups(lowerer, block.node)
        emit_mecc_clear_root_scope(lowerer, lowerer.mecc_root_scopes.length - 1)
    }
    lowerer.locals = saved_locals
    lowerer.block_stack = array<BlockStmt*>(lowerer.block_stack, old_block_depth)
    lowerer.mecc_root_scopes = array<string[]>(lowerer.mecc_root_scopes, old_mecc_depth)
    lowerer.value_cleanup_scopes = array<value_cleanup[]>(lowerer.value_cleanup_scopes, old_value_depth)
    return terminated
}

bool emit_stmt(llvm_lowerer* lowerer, Stmt statement) {
    if statement.kind == STMT_VAR {
        VarDeclStmt* item = bootstrap_as_var_decl_stmt(statement)
        SemanticType* sem = resolve_ref(lowerer, item.Type)
        if item.Type != null && item.Type.Name == "auto" && item.Initializer.kind != 0 { sem = clone_type(lowerer.result.expression_types[item.Initializer]) }
        string ty = llvm_type(lowerer, sem); string address = next_register(lowerer)
        raw_line(lowerer, `  ${address} = alloca ${ty}`)
        ir_local local; local.address = address; local.type_info = sem; lowerer.locals[item.Name] = local
        IRValue value = zero_value(lowerer, sem)
        if item.Initializer.kind != 0 {
            if item.Initializer.kind == EXPR_ARRAY && sem != null && (sem.kind == "array" || sem.array_dimensions.length > 0) { value = emit_array_expr(lowerer, bootstrap_as_array_expr(item.Initializer), sem, array_element_type(lowerer, sem)) }
            else { value = emit_expr(lowerer, item.Initializer) }
            value = coerce(lowerer, value, sem)
        } else if sem != null && sem.kind == "struct" && sem.pointer_depth == 0 { value = default_struct_value(lowerer, sem) }
        else if sem != null && (sem.kind == "array" || sem.array_dimensions.length > 0) { value = default_array_value(lowerer, sem) }
        raw_line(lowerer, `  store ${ty} ${value.value}, ptr ${address}`)
        if is_value_aggregate(sem) && lowerer.value_cleanup_scopes.length > 0 { int64 index = lowerer.value_cleanup_scopes.length - 1; int64 n = lowerer.value_cleanup_scopes[index].length; lowerer.value_cleanup_scopes[index] = array<value_cleanup>(lowerer.value_cleanup_scopes[index], n + 1); value_cleanup cleanup; cleanup.address = address; cleanup.type_info = sem; lowerer.value_cleanup_scopes[index][n] = cleanup }
        if lowerer.result.mecc_enabled && semantic_is_pointer(sem) { raw_line(lowerer, `  call void @clyth_mecc_store(ptr null, ptr ${address}, ptr ${value.value})`); register_mecc_root(lowerer, address) }
        return false
    }
    if statement.kind == STMT_EXPR {
        ExprStmt* item = bootstrap_as_expr_stmt(statement); emit_expr(lowerer, item.Expression)
        if item.Expression.kind == EXPR_CALL { CallExpr* call = bootstrap_as_call_expr(item.Expression); if call.Callee.kind == EXPR_IDENTIFIER && bootstrap_as_identifier_expr(call.Callee).Name == "raise" && lowerer.catch_stack.length > 0 { return true } }
        return false
    }
    if statement.kind == STMT_RETURN {
        ReturnStmt* item = bootstrap_as_return_stmt(statement)
        if lowerer.catch_stack.length > 0 {
            if item.Value.kind != 0 { emit_expr(lowerer, item.Value) }
            catch_context context = lowerer.catch_stack[lowerer.catch_stack.length - 1]
            emit_value_cleanups_from(lowerer, context.block_depth); emit_lifetime_cleanups(lowerer, node_from_stmt(statement)); raw_line(lowerer, `  br label %${context.end_label}`); return true
        }
        IRValue value = zero_value(lowerer, lowerer.return_type)
        if item.Value.kind != 0 { value = coerce(lowerer, emit_expr(lowerer, item.Value), lowerer.return_type) }
        emit_value_cleanups_from(lowerer, 0); emit_lifetime_cleanups(lowerer, node_from_stmt(statement)); emit_mecc_function_frontier(lowerer)
        if llvm_type(lowerer, lowerer.return_type) == "void" { raw_line(lowerer, "  ret void") } else { raw_line(lowerer, `  ret ${llvm_type(lowerer, lowerer.return_type)} ${value.value}`) }
        return true
    }
    if statement.kind == STMT_BLOCK { return emit_block(lowerer, bootstrap_as_block_stmt(statement)) }
    if statement.kind == STMT_IF {
        IfStmt* item = bootstrap_as_if_stmt(statement); IRValue condition = to_bool(lowerer, emit_expr(lowerer, item.Condition)); string then_label = next_label(lowerer, "if.then"); string else_label = next_label(lowerer, "if.else"); string end_label = next_label(lowerer, "if.end")
        raw_line(lowerer, `  br i1 ${condition.value}, label %${then_label}, label %${else_label}`); raw_line(lowerer, then_label + ":")
        bool then_term = emit_stmt(lowerer, item.Then); if !then_term { raw_line(lowerer, `  br label %${end_label}`) }
        raw_line(lowerer, else_label + ":"); bool else_term = false; if item.Else.kind != 0 { else_term = emit_stmt(lowerer, item.Else) }; if !else_term { raw_line(lowerer, `  br label %${end_label}`) }; if then_term && else_term { return true }; raw_line(lowerer, end_label + ":"); return false
    }
    if statement.kind == STMT_WHILE {
        WhileStmt* item = bootstrap_as_while_stmt(statement); string cond_label = next_label(lowerer, "while.cond"); string body_label = next_label(lowerer, "while.body"); string end_label = next_label(lowerer, "while.end")
        raw_line(lowerer, `  br label %${cond_label}`); raw_line(lowerer, cond_label + ":"); IRValue condition = to_bool(lowerer, emit_expr(lowerer, item.Condition)); raw_line(lowerer, `  br i1 ${condition.value}, label %${body_label}, label %${end_label}`); raw_line(lowerer, body_label + ":")
        int64 n = lowerer.break_labels.length; lowerer.break_labels = array<string>(lowerer.break_labels, n+1); lowerer.break_labels[n]=end_label; n=lowerer.continue_labels.length; lowerer.continue_labels = array<string>(lowerer.continue_labels, n+1); lowerer.continue_labels[n]=cond_label; n=lowerer.break_cleanup_depths.length; lowerer.break_cleanup_depths = array<int64>(lowerer.break_cleanup_depths, n+1); lowerer.break_cleanup_depths[n]=lowerer.block_stack.length; n=lowerer.continue_cleanup_depths.length; lowerer.continue_cleanup_depths = array<int64>(lowerer.continue_cleanup_depths, n+1); lowerer.continue_cleanup_depths[n]=lowerer.block_stack.length
        bool term = emit_stmt(lowerer, item.Body); lowerer.break_labels = array<string>(lowerer.break_labels, lowerer.break_labels.length-1); lowerer.continue_labels = array<string>(lowerer.continue_labels, lowerer.continue_labels.length-1); lowerer.break_cleanup_depths = array<int64>(lowerer.break_cleanup_depths, lowerer.break_cleanup_depths.length-1); lowerer.continue_cleanup_depths = array<int64>(lowerer.continue_cleanup_depths, lowerer.continue_cleanup_depths.length-1)
        if !term { raw_line(lowerer, `  br label %${cond_label}`) }; raw_line(lowerer, end_label + ":"); return false
    }
    if statement.kind == STMT_FOR {
        ForStmt* item = bootstrap_as_for_stmt(statement); if item.Init.kind != 0 { emit_stmt(lowerer, item.Init) }
        string cond_label=next_label(lowerer,"for.cond"); string body_label=next_label(lowerer,"for.body"); string post_label=next_label(lowerer,"for.post"); string end_label=next_label(lowerer,"for.end")
        raw_line(lowerer, `  br label %${cond_label}`); raw_line(lowerer, cond_label + ":")
        if item.Condition.kind != 0 { IRValue c=to_bool(lowerer,emit_expr(lowerer,item.Condition)); raw_line(lowerer, `  br i1 ${c.value}, label %${body_label}, label %${end_label}`) } else { raw_line(lowerer, `  br label %${body_label}`) }
        raw_line(lowerer, body_label + ":")
        int64 n=lowerer.break_labels.length; lowerer.break_labels = array<string>(lowerer.break_labels, n+1); lowerer.break_labels[n]=end_label; n=lowerer.continue_labels.length; lowerer.continue_labels = array<string>(lowerer.continue_labels, n+1); lowerer.continue_labels[n]=post_label; n=lowerer.break_cleanup_depths.length; lowerer.break_cleanup_depths = array<int64>(lowerer.break_cleanup_depths, n+1); lowerer.break_cleanup_depths[n]=lowerer.block_stack.length; n=lowerer.continue_cleanup_depths.length; lowerer.continue_cleanup_depths = array<int64>(lowerer.continue_cleanup_depths, n+1); lowerer.continue_cleanup_depths[n]=lowerer.block_stack.length
        bool term=emit_stmt(lowerer,item.Body); lowerer.break_labels = array<string>(lowerer.break_labels, lowerer.break_labels.length-1); lowerer.continue_labels = array<string>(lowerer.continue_labels, lowerer.continue_labels.length-1); lowerer.break_cleanup_depths = array<int64>(lowerer.break_cleanup_depths, lowerer.break_cleanup_depths.length-1); lowerer.continue_cleanup_depths = array<int64>(lowerer.continue_cleanup_depths, lowerer.continue_cleanup_depths.length-1)
        if !term { raw_line(lowerer, `  br label %${post_label}`) }; raw_line(lowerer, post_label + ":"); if item.Post.kind != 0 { emit_expr(lowerer,item.Post) }; raw_line(lowerer, `  br label %${cond_label}`); raw_line(lowerer,end_label+":"); return false
    }
    if statement.kind == STMT_SWITCH {
        SwitchStmt* item=bootstrap_as_switch_stmt(statement); IRValue switch_value=emit_expr(lowerer,item.Value); string end_label=next_label(lowerer,"switch.end"); string[] case_labels; case_labels = array<string>(case_labels, item.Cases.length); string default_label=end_label; int64 i=0
        while i<item.Cases.length {case_labels[i]=next_label(lowerer,"switch.case"); if item.Cases[i].Default {default_label=case_labels[i]}; i+=1}
        string current_test=next_label(lowerer,"switch.test"); raw_line(lowerer,`  br label %${current_test}`); int64[] nondefault; i=0; while i<item.Cases.length {if !item.Cases[i].Default {int64 n=nondefault.length; nondefault = array<int64>(nondefault, n+1); nondefault[n]=i}; i+=1}
        int64 pos=0; while pos<nondefault.length {int64 index=nondefault[pos]; raw_line(lowerer,current_test+":"); IRValue case_value=coerce(lowerer,emit_expr(lowerer,item.Cases[index].Value),switch_value.type_info); string cmp=next_register(lowerer); raw_line(lowerer,`  ${cmp} = icmp eq ${switch_value.llvm_type} ${switch_value.value}, ${case_value.value}`); string next=default_label; if pos+1<nondefault.length {next=next_label(lowerer,"switch.test")}; raw_line(lowerer,`  br i1 ${cmp}, label %${case_labels[index]}, label %${next}`); current_test=next; pos+=1}
        if nondefault.length==0 {raw_line(lowerer,current_test+":"); raw_line(lowerer,`  br label %${default_label}`)}
        int64 n=lowerer.break_labels.length; lowerer.break_labels = array<string>(lowerer.break_labels, n+1); lowerer.break_labels[n]=end_label; n=lowerer.break_cleanup_depths.length; lowerer.break_cleanup_depths = array<int64>(lowerer.break_cleanup_depths, n+1); lowerer.break_cleanup_depths[n]=lowerer.block_stack.length
        i=0; while i<item.Cases.length {raw_line(lowerer,case_labels[i]+":"); bool terminated=false; int64 j=0; while j<item.Cases[i].Statements.length {if emit_stmt(lowerer,item.Cases[i].Statements[j]) {terminated=true; break}; j+=1}; if !terminated {string next=end_label; if i+1<item.Cases.length {next=case_labels[i+1]}; raw_line(lowerer,`  br label %${next}`)}; i+=1}
        lowerer.break_labels = array<string>(lowerer.break_labels, lowerer.break_labels.length-1); lowerer.break_cleanup_depths = array<int64>(lowerer.break_cleanup_depths, lowerer.break_cleanup_depths.length-1); raw_line(lowerer,end_label+":"); return false
    }
    if statement.kind == STMT_BREAK { if lowerer.break_labels.length>0 {if lowerer.break_cleanup_depths.length>0 {emit_control_scope_cleanups(lowerer,lowerer.break_cleanup_depths[lowerer.break_cleanup_depths.length-1])}; raw_line(lowerer,`  br label %${lowerer.break_labels[lowerer.break_labels.length-1]}`); return true}; return false }
    if statement.kind == STMT_CONTINUE { if lowerer.continue_labels.length>0 {if lowerer.continue_cleanup_depths.length>0 {emit_control_scope_cleanups(lowerer,lowerer.continue_cleanup_depths[lowerer.continue_cleanup_depths.length-1])}; raw_line(lowerer,`  br label %${lowerer.continue_labels[lowerer.continue_labels.length-1]}`); return true}; return false }
    return false
}

string bootstrap_strip_numeric_underscores(string value) { string output=""; int64 i=0; while i<bootstrap_string_length(value) { string ch=bootstrap_string_slice(value,i,1); if ch!="_" {output = output + ch}; i+=1 }; if output=="" {return "0"}; return output }
string bootstrap_unquote_literal(string value) { int64 n=bootstrap_string_length(value); if n>=2 { string first=bootstrap_string_slice(value,0,1); string last=bootstrap_string_slice(value,n-1,1); if first==last { return bootstrap_string_slice(value,1,n-2) } }; return value }
int64 bootstrap_char_literal_value(string raw) { string text=bootstrap_unquote_literal(raw); if bootstrap_string_length(text)==0 {return 0}; if bootstrap_string_slice(text,0,1)!="\\" {return text[0]}; if bootstrap_string_length(text)<2 {return 0}; string esc=bootstrap_string_slice(text,1,1); if esc=="n" {return 10}; if esc=="r" {return 13}; if esc=="t" {return 9}; if esc=="0" {return 0}; if esc=="\\" {return 92}; if esc=="'" {return 39}; if esc=="\"" {return 34}; return esc[0] }
string bootstrap_cmp_predicate(string op, bool unsigned_value) { if op=="==" {return "eq"}; if op=="!=" {return "ne"}; if op=="<" {if unsigned_value{return "ult"};return "slt"}; if op=="<=" {if unsigned_value{return "ule"};return "sle"}; if op==">" {if unsigned_value{return "ugt"};return "sgt"}; if op==">=" {if unsigned_value{return "uge"};return "sge"}; return "eq" }
string bootstrap_fp_predicate(string pred) { if pred=="eq" {return "oeq"}; if pred=="ne" {return "one"}; if pred=="slt"||pred=="ult" {return "olt"}; if pred=="sle"||pred=="ule" {return "ole"}; if pred=="sgt"||pred=="ugt" {return "ogt"}; if pred=="sge"||pred=="uge" {return "oge"}; return "oeq" }
string bootstrap_arithmetic_op(string op, bool floating, bool unsigned_value) { if floating {if op=="+"||op=="+=" {return "fadd"};if op=="-"||op=="-=" {return "fsub"};if op=="*"||op=="*=" {return "fmul"};if op=="/"||op=="/=" {return "fdiv"};if op=="%"||op=="%=" {return "frem"};return ""}; if op=="+"||op=="+=" {return "add"};if op=="-"||op=="-=" {return "sub"};if op=="*"||op=="*=" {return "mul"};if op=="/"||op=="/=" {if unsigned_value{return "udiv"};return "sdiv"};if op=="%"||op=="%=" {if unsigned_value{return "urem"};return "srem"};return "" }

IRValue emit_expr(llvm_lowerer* lowerer, Expr expression) {
    SemanticType* sem = specialize_type(lowerer, lowerer.result.expression_types[expression])
    if sem == null || sem.kind == "unknown" { sem = specialize_type(lowerer, infer_expression_type(lowerer, expression)) }
    if sem == null { sem = new SemanticType(); sem.kind = "unknown" }
    if expression.kind == EXPR_LITERAL {
        LiteralExpr* item=bootstrap_as_literal_expr(expression); SemanticType* natural=literal_type(lowerer,item); IRValue out; out.type_info=natural
        if item.Kind=="integer" {out.llvm_type=llvm_type(lowerer,natural); out.value=bootstrap_strip_numeric_underscores(item.Raw); return out}
        if item.Kind=="float" {out.llvm_type=llvm_type(lowerer,natural); out.value=item.Raw; return out}
        if item.Kind=="bool" {out.llvm_type="i1"; if item.Raw=="true" {out.value="1"} else {out.value="0"}; return out}
        if item.Kind=="null" {out.llvm_type="ptr"; out.value="null"; return out}
        if item.Kind=="character" {out.llvm_type="i8"; out.value=`${bootstrap_char_literal_value(item.Raw)}`; return out}
        if item.Kind=="string" {return static_string_value(lowerer,bootstrap_unquote_literal(item.Raw),natural)}
        if item.Kind=="interpolated_string" {return emit_interpolated_string(lowerer,item,natural)}
        return zero_value(lowerer,sem)
    }
    if expression.kind == EXPR_IDENTIFIER {
