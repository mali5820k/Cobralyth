import "../token/token.clyth"
import "../ast/ast.clyth"
import "../lexer/lexer.clyth"
import string

struct ParserError {
	Span Span
	string Message

    constructor(Span span, string message) { Span = span; Message = message }
}

string ParserErrorString(ParserError e) { // translated Go receiver method
	return `${e.Span.Start.Line}:${e.Span.Start.Column}: ${e.Message}`
}

struct Parser {
	Token[] tokens
	int64 pos
	ParserError[] errs
}

bool parser_stage2_trace_enabled() { return environment_value_copy("CLYTH_STAGE2_TRACE") != "" }
void parser_stage2_trace(string text) { if parser_stage2_trace_enabled() { println("stage2-parser: "+text) } }

struct NewResult {
    Parser* parser
    LexerError[] lexErrors
}

struct ParseResult {
    Program* program
    ParserError[] parseErrors
    LexerError[] lexErrors
}

struct ExpressionParseResult {
    Expr expression
    ParserError[] parseErrors
    LexerError[] lexErrors
}

ParserError[] append_parser_error(ParserError[] values, ParserError value) {
    int64 n = values.length
    ParserError[] replacement = array<ParserError>(n + 1)
    int64 i = 0
    while i < n { replacement[i] = values[i]; i += 1 }
    replacement[n] = value
    return replacement
}

Decl[] append_decl(Decl[] values, Decl value) {
    int64 n = values.length
    Decl[] replacement = array<Decl>(n + 1)
    int64 i = 0
    while i < n { replacement[i] = values[i]; i += 1 }
    replacement[n] = value
    return replacement
}

EnumMember*[] append_enum_member(EnumMember*[] values, EnumMember* value) {
    int64 n = values.length
    EnumMember*[] replacement = array<EnumMember*>(n + 1)
    int64 i = 0
    while i < n { replacement[i] = values[i]; i += 1 }
    replacement[n] = value
    return replacement
}

