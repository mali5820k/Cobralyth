// Clyth Runtime Module: collections/list
// License: MIT
//
// Clyth V1.0.0 List<T> keeps its high-level API in Clyth-space while relying
// only on the primitive dynamic-array resize operation for backing storage.

struct List<T> {
    private T[] data
    int64 length
    int64 capacity

    constructor(T[] initial_values) {
        data = initial_values
        length = initial_values.length
        capacity = initial_values.length
    }

    bool empty() {
        return length == 0
    }

    T get(int64 index) {
        return data[index]
    }

    void set(int64 index, T value) {
        data[index] = value
    }

    void append(T value) {
        ensure_capacity(length + 1)
        data[length] = value
        length += 1
    }

    T pop() {
        if length == 0 {
            T default_value
            return default_value
        }
        length -= 1
        return data[length]
    }

    void push_front(T value) {
        ensure_capacity(length + 1)
        int64 i = length
        while i > 0 {
            data[i] = data[i - 1]
            i -= 1
        }
        data[0] = value
        length += 1
    }

    T pop_front() {
        if length == 0 {
            T default_value
            return default_value
        }
        T value = data[0]
        int64 i = 0
        while i < length - 1 {
            data[i] = data[i + 1]
            i += 1
        }
        length -= 1
        return value
    }

    bool remove_index(int64 index) {
        if index < 0 {
            return false
        }
        if index >= length {
            return false
        }
        int64 i = index
        while i < length - 1 {
            data[i] = data[i + 1]
            i += 1
        }
        length -= 1
        return true
    }

    bool remove_value(T value) {
        int64 i = 0
        while i < length {
            if data[i] == value {
                return remove_index(i)
            }
            i += 1
        }
        return false
    }

    void resize(int64 new_size) {
        if new_size < 0 {
            return
        }
        ensure_capacity(new_size)
        if new_size > length {
            while length < new_size {
                T default_value
                data[length] = default_value
                length += 1
            }
            return
        }
        length = new_size
    }

    void clear() {
        length = 0
    }

    private void ensure_capacity(int64 required_capacity) {
        if capacity >= required_capacity {
            return
        }
        int64 next_capacity = capacity
        if next_capacity == 0 {
            next_capacity = 4
        }
        while next_capacity < required_capacity {
            next_capacity *= 2
        }
        grow_to(next_capacity)
    }

    private void grow_to(int64 new_capacity) {
        T[] replacement = array<T>(new_capacity)
        int64 copy_index = 0
        while copy_index < length {
            replacement[copy_index] = data[copy_index]
            copy_index += 1
        }
        data = replacement
        capacity = new_capacity
    }
}
