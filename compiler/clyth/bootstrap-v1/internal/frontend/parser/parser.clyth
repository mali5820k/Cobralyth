    int64 n = values.length
    ProtocolMember*[] replacement = array<ProtocolMember*>(n + 1)
    int64 i = 0
    while i < n { replacement[i] = values[i]; i += 1 }
    replacement[n] = value
    return replacement
}

GenericParameter[] append_generic_parameter(GenericParameter[] values, GenericParameter value) {
    int64 n = values.length
    GenericParameter[] replacement = array<GenericParameter>(n + 1)
