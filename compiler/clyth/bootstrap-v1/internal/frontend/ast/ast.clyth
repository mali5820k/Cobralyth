// package ast

import "../token/token.clyth"

// Go interfaces are represented as explicit tagged pointer carriers in the
// self-hosted compiler.  This keeps the source-level structure of the Go
// implementation while expressing dynamic AST dispatch in Clyth itself.
struct Decl {
    int32 kind
    MeccConfigDirectiveDecl* mecc_config
    ErrorTypeDirectiveDecl* error_type
    ImportDecl* import_decl
    FunctionDecl* function_decl
    StructDecl* struct_decl
    EnumDecl* enum_decl
    MethodBlockDecl* method_block_decl
    ProtocolDecl* protocol_decl
    GlobalVarDecl* global_var_decl
}

struct Stmt {
    int32 kind
    BlockStmt* block_stmt
    MeccConfigDirectiveStmt* mecc_config
    VarDeclStmt* var_decl
    ReturnStmt* return_stmt
    IfStmt* if_stmt
    WhileStmt* while_stmt
    ForStmt* for_stmt
    SwitchStmt* switch_stmt
    BreakStmt* break_stmt
    ContinueStmt* continue_stmt
    ExprStmt* expr_stmt
}

struct Expr {
    int32 kind
    IdentifierExpr* identifier
    LiteralExpr* literal
    UnaryExpr* unary
    BinaryExpr* binary
    AssignExpr* assign
    CallExpr* call
    GenericSpecializationExpr* generic_specialization
    MemberExpr* member
    IndexExpr* index
    ArrayExpr* array
    KeyValueExpr* key_value
    LambdaExpr* lambda
    NewExpr* new_expr
    CastExpr* cast_expr
    uint64 hash() { return 17 }
}


// Node is the self-hosted equivalent of Go's ast.Node interface.  It carries
// the concrete tagged declaration/statement/expression value explicitly so
// semantic analysis, lifetime planning and lowering can share one source-span
// abstraction without relying on interface dispatch.
struct Node {
    int32 category
    Decl declaration
    Stmt statement
    Expr expression
    FieldDecl* field
    MethodDecl* method
    Parameter* parameter
    ProtocolMember* protocol_member
    TypeRef* type_ref
    SwitchCase* switch_case
    uint64 hash() { return 23 }
}

int32 NODE_DECL = 1
int32 NODE_STMT = 2
int32 NODE_EXPR = 3

Node node_from_decl(Decl value) { Node n; n.category=NODE_DECL; n.declaration=value; return n }
Node node_from_stmt(Stmt value) { Node n; n.category=NODE_STMT; n.statement=value; return n }
Node node_from_expr(Expr value) { Node n; n.category=NODE_EXPR; n.expression=value; return n }

Span node_span(Node value) {
    if value.category == NODE_DECL { return decl_span(value.declaration) }
    if value.category == NODE_STMT { return stmt_span(value.statement) }
    if value.category == NODE_EXPR { return expr_span(value.expression) }
    if value.category == 10 && value.field != null { return value.field.SourceSpan }
    if value.category == 11 && value.method != null { return value.method.Function.SourceSpan }
    if value.category == 12 && value.parameter != null { return value.parameter.SourceSpan }
    if value.category == 13 && value.protocol_member != null { return value.protocol_member.SourceSpan }
    if value.category == 14 && value.type_ref != null { return value.type_ref.SourceSpan }
    if value.category == 15 && value.switch_case != null { return value.switch_case.SourceSpan }
    Span empty
    return empty
}

struct Program {
	Decl[] Declarations
	Span SourceSpan
}

// MeccConfigDirectiveDecl is a file-scope compiler directive.  It is parsed as
// structured compiler metadata rather than textual macro substitution.
struct MeccConfigDirectiveDecl {
	string Property
	bool Value
	Span SourceSpan
}

// ErrorTypeDirectiveDecl registers a compile-time ErrorType identity. It is
// compiler metadata, not a runtime variable or textual macro expansion.
struct ErrorTypeDirectiveDecl {
	string Name
	Span SourceSpan
}

