// Clyth Runtime Module: collections/set
// License: MIT

import hash
//
// Clyth V1.0.0 runtime design:
//   Set<T> is a Clyth-space runtime container. This bootstrap implementation
//   uses a primitive T[] backing directly so the compiler only lowers arrays,
//   structs, constructors, and methods. A later runtime pass can replace this
//   with a hash-backed implementation without reintroducing compiler-owned Set
//   lowering.

struct Set<T> {
    private T[] values
    int64 length
    int64 capacity



    constructor(T[] initial_values) {
        values = initial_values
        length = 0
        capacity = initial_values.length

        int64 i = 0
        while i < initial_values.length {
            T value = initial_values[i]
            if contains(value) == false {
                values[length] = value
                length += 1
            }
            i += 1
        }
    }

    bool empty() {
        return length == 0
    }

    T get(int64 index) {
        return values[index]
    }

    bool contains(T value) {
        int64 i = 0
        while i < length {
            if values[i] == value {
                return true
            }
            i += 1
        }
        return false
    }

    void insert(T value) {
        if contains(value) {
            return
        }
        ensure_capacity(length + 1)
        values[length] = value
        length += 1
    }

    bool remove(T value) {
        int64 i = 0
        while i < length {
            if values[i] == value {
                int64 j = i
                while j < length - 1 {
                    values[j] = values[j + 1]
                    j += 1
                }
                length -= 1
                return true
            }
            i += 1
        }
        return false
    }

    void clear() {
        length = 0
    }

    private void ensure_capacity(int64 required_capacity) {
        if capacity >= required_capacity {
            return
        }
        int64 next_capacity = capacity
        if next_capacity == 0 {
            next_capacity = 4
        }
        while next_capacity < required_capacity {
            next_capacity *= 2
        }
        T[] replacement = array<T>(next_capacity)
        int64 copy_index = 0
        while copy_index < length {
            replacement[copy_index] = values[copy_index]
            copy_index += 1
        }
        values = replacement
        capacity = next_capacity
    }
}
