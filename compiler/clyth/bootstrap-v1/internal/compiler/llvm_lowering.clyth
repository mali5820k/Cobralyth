IRValue emit_lambda(llvm_lowerer* lowerer, LambdaExpr* lambda, SemanticType* sem) {
    lowerer.lambda += 1; string name="clyth.lambda."+`${lowerer.lambda}`
    string[] saved_lines=lowerer.current_lines; Map<string,ir_local> saved_locals=lowerer.locals; SemanticType* saved_return=lowerer.return_type; StructInfo* saved_receiver=lowerer.receiver; int64 saved_reg=lowerer.register; int64 saved_label=lowerer.label
    lowerer.register=0; lowerer.label=0; lowerer.current_lines = array<string>(lowerer.current_lines, 0); lowerer.locals=Map<string,ir_local>(); lowerer.receiver=null
    SemanticCallable* callable=null; if sem!=null {callable=sem.callable}; if callable==null {callable=new SemanticCallable(); callable.return_type=new SemanticType(); callable.return_type.kind="void"; callable.return_type.name="void"}
    lowerer.return_type=callable.return_type; string[] params; int64 i=0
    while i<lambda.Parameters.length {SemanticType* pt=new SemanticType(); pt.kind="unknown"; if i<callable.parameters.length {pt=callable.parameters[i]}; string ty=llvm_type(lowerer,pt); int64 n=params.length; params = array<string>(params, n+1); params[n]=ty+` %arg.${i}`; string addr=`%lambda.arg.addr.${i}`; ir_local local; local.address=addr; local.type_info=pt; lowerer.locals[lambda.Parameters[i].Name]=local; i+=1}
    raw_line(lowerer,"define internal "+llvm_type(lowerer,callable.return_type)+" @"+name+"("+join_llvm_strings(params,", ")+") {"); raw_line(lowerer,"entry:")
    i=0; while i<lambda.Parameters.length {ir_local local=lowerer.locals[lambda.Parameters[i].Name]; string ty=llvm_type(lowerer,local.type_info); raw_line(lowerer,`  ${local.address} = alloca ${ty}`); raw_line(lowerer,`  store ${ty} %arg.${i}, ptr ${local.address}`); i+=1}
    bool term=emit_block(lowerer,lambda.Body); if !term {emit_default_return(lowerer,callable.return_type)}; raw_line(lowerer,"}"); string lambda_def=join_llvm_strings(lowerer.current_lines,"\n")
    lowerer.current_lines=saved_lines; lowerer.locals=saved_locals; lowerer.return_type=saved_return; lowerer.receiver=saved_receiver; lowerer.register=saved_reg; lowerer.label=saved_label; int64 n=lowerer.function_defs.length; lowerer.function_defs = array<string>(lowerer.function_defs, n+1); lowerer.function_defs[n]=lambda_def
    IRValue result; result.llvm_type="ptr"; result.value="@"+name; result.type_info=sem; return result
}

bool span_contains(Node outer, Node inner) { Span a=node_span(outer); Span b=node_span(inner); return a.Start.Offset<=b.Start.Offset && a.End.Offset>=b.End.Offset }

void prepare_cleanup_slots(llvm_lowerer* lowerer, Node body) {
    if body.kind == 0 { return }
    Map<int64, bool> needed = Map<int64, bool>()
    int64 i = 0
    while i < lowerer.result.lifetime_actions.length {
        LifetimeAction action = lowerer.result.lifetime_actions[i]
        if action.kind == "cleanup" && action.allocation > 0 {
            AllocationInfo* info = lowerer.result.allocations[action.allocation]
            if info != null && info.new_expr != null && !info.mecc && span_contains(body, info.new_expr.node) {
                needed[action.allocation] = true
            }
        }
        i += 1
    }
    int64[] ids = needed.keys()
    i = 1
    while i < ids.length {
        int64 value = ids[i]
        int64 j = i
        while j > 0 && ids[j - 1] > value { ids[j] = ids[j - 1]; j -= 1 }
        ids[j] = value
        i += 1
    }
    i = 0
    while i < ids.length {
        string slot = next_register(lowerer)
        raw_line(lowerer, `  ${slot} = alloca ptr`)
        raw_line(lowerer, `  store ptr null, ptr ${slot}`)
        lowerer.cleanup_slots[ids[i]] = slot
        i += 1
    }
}

void emit_destructor_for_value(llvm_lowerer* lowerer, string value, AllocationInfo* info) {
    if info == null || info.type_info == null { return }
    SemanticType* type_info = clone_type(info.type_info)
    if type_info.pointer_depth > 0 { type_info.pointer_depth -= 1 }
    string name = base_type_name(type_info)
    StructInfo* struct_info = lowerer.struct_info[name]
    if struct_info == null || !struct_info.destructor { return }
    string fn = llvm_destructor_name(name)
    if !lowerer.defined[fn] && lowerer.declarations[fn] == "" { lowerer.declarations[fn] = `declare void @${fn}(ptr)` }
    raw_line(lowerer, `  call void @${fn}(ptr ${value})`)
}

void emit_lifetime_cleanups(llvm_lowerer* lowerer, Node node) {
    LifetimeAction[] actions = lowerer.lifetime_actions[node]
    int64 i = 0
    while i < actions.length {
        LifetimeAction action = actions[i]
        if action.kind == "cleanup" {
            string slot = lowerer.cleanup_slots[action.allocation]
            if slot != "" {
                string value = next_register(lowerer)
                raw_line(lowerer, `  ${value} = load ptr, ptr ${slot}`)
                string occupied = next_register(lowerer)
                raw_line(lowerer, `  ${occupied} = icmp ne ptr ${value}, null`)
                string free_label = next_label(lowerer, "cleanup.free")
                string done_label = next_label(lowerer, "cleanup.done")
                raw_line(lowerer, `  br i1 ${occupied}, label %${free_label}, label %${done_label}`)
                raw_line(lowerer, free_label + ":")
                AllocationInfo* info = lowerer.result.allocations[action.allocation]
                emit_destructor_for_value(lowerer, value, info)
                raw_line(lowerer, `  call void @free(ptr ${value})`)
                raw_line(lowerer, `  store ptr null, ptr ${slot}`)
                raw_line(lowerer, `  br label %${done_label}`)
                raw_line(lowerer, done_label + ":")
            }
        }
        i += 1
    }
}

void register_mecc_root(llvm_lowerer* lowerer, string slot) { if !lowerer.result.mecc_enabled || slot=="" || lowerer.mecc_root_scopes.length==0 {return}; int64 index=lowerer.mecc_root_scopes.length-1; auto n=lowerer.mecc_root_scopes[index].length; lowerer.mecc_root_scopes[index] = array<string>(lowerer.mecc_root_scopes[index], n+1); lowerer.mecc_root_scopes[index][n]=slot }

void emit_mecc_clear_root_scope(llvm_lowerer* lowerer, int64 index) { if !lowerer.result.mecc_enabled || index<0 || index>=lowerer.mecc_root_scopes.length {return}; int64 i=0; while i<lowerer.mecc_root_scopes[index].length {string slot=lowerer.mecc_root_scopes[index][i]; raw_line(lowerer, `  call void @clyth_mecc_store(ptr null, ptr ${slot}, ptr null)`); i+=1} }

void emit_mecc_clear_all_roots(llvm_lowerer* lowerer) { if !lowerer.result.mecc_enabled {return}; int64 index=lowerer.mecc_root_scopes.length-1; while index>=0 {emit_mecc_clear_root_scope(lowerer,index); index-=1} }

void emit_mecc_function_frontier(llvm_lowerer* lowerer) { if !lowerer.result.mecc_enabled {return}; emit_mecc_clear_all_roots(lowerer); if llvm_type(lowerer,lowerer.return_type)!="ptr" {raw_line(lowerer,"  call void @clyth_mecc_collapse()")}}

void emit_default_return(llvm_lowerer* lowerer, SemanticType* type_info) { emit_mecc_function_frontier(lowerer); IRValue value=zero_value(lowerer,type_info); if value.llvm_type=="void" {raw_line(lowerer,"  ret void")} else {raw_line(lowerer, `  ret ${value.llvm_type} ${value.value}`)} }
IRValue zero_value(llvm_lowerer* lowerer, SemanticType* type_info) { IRValue result; result.llvm_type=llvm_type(lowerer,type_info); result.type_info=type_info; result.value="0"; if result.llvm_type=="ptr" {result.value="null"} else if result.llvm_type=="float"||result.llvm_type=="double" {result.value="0.0"} else if result.llvm_type=="void" {result.value=""}; return result }

IRValue clone_struct_value(llvm_lowerer* lowerer, IRValue value, SemanticType* target) {
    StructInfo* info=lowerer.struct_info[base_type_name(target)]
    IRValue result; result.llvm_type="ptr"; result.value=value.value; result.type_info=target
    if info==null || value.value=="null" {return result}
    string copy_value=next_register(lowerer); raw_line(lowerer, `  ${copy_value} = call ptr @calloc(i64 1, i64 ${struct_storage_size(lowerer,info)})`)
    int64 i=0
    while i<info.field_order.length {
        string name=info.field_order[i]; Symbol* field=info.fields[name]
        if field!=null {
            SemanticType* field_type=specialize_type(lowerer,field.type_info); string source_address=field_address(lowerer,value.value,info,name); string destination_address=field_address(lowerer,copy_value,info,name); string ty=llvm_type(lowerer,field_type); string loaded=next_register(lowerer)
            raw_line(lowerer, `  ${loaded} = load ${ty}, ptr ${source_address}`)
            IRValue field_value; field_value.llvm_type=ty; field_value.value=loaded; field_value.type_info=field_type
            if field_type.kind=="struct" && field_type.pointer_depth==0 {field_value=clone_struct_value(lowerer,field_value,field_type)} else if field_type.kind=="array" || field_type.array_dimensions.length>0 {field_value=clone_array_value(lowerer,field_value,field_type)}
            raw_line(lowerer, `  store ${field_value.llvm_type} ${field_value.value}, ptr ${destination_address}`)
            if lowerer.result.mecc_enabled && semantic_is_pointer(field_type) && field_value.llvm_type=="ptr" {
                raw_line(lowerer, `  call void @clyth_mecc_store(ptr ${copy_value}, ptr ${destination_address}, ptr ${field_value.value})`)
            }
        }
        i+=1
    }
    result.value=copy_value; result.fresh=true; return result
}

IRValue clone_array_value(llvm_lowerer* lowerer, IRValue value, SemanticType* target) {
    IRValue result; result.llvm_type="ptr"; result.value="null"; result.type_info=target
    if value.value=="null" {return result}
    string length_slot=next_register(lowerer); raw_line(lowerer, `  ${length_slot} = getelementptr i8, ptr ${value.value}, i64 8`)
    string length=next_register(lowerer); raw_line(lowerer, `  ${length} = load i64, ptr ${length_slot}`)
    string source_data=array_data_pointer(lowerer,value.value); SemanticType* element=array_element_type(lowerer,target); int64 element_size=semantic_storage_size(lowerer,element)
    string new_header=next_register(lowerer); raw_line(lowerer, `  ${new_header} = call ptr @calloc(i64 1, i64 16)`)
    string bytes=next_register(lowerer); raw_line(lowerer, `  ${bytes} = mul i64 ${length}, ${element_size}`)
    string new_data=next_register(lowerer); raw_line(lowerer, `  ${new_data} = call ptr @calloc(i64 ${length}, i64 ${element_size})`)
    if element.kind=="struct" && element.pointer_depth==0 {
        string index_slot=next_register(lowerer); raw_line(lowerer, `  ${index_slot} = alloca i64`); raw_line(lowerer, `  store i64 0, ptr ${index_slot}`)
        string cond_label=next_label(lowerer,"array.copy.cond"); string body_label=next_label(lowerer,"array.copy.body"); string end_label=next_label(lowerer,"array.copy.end"); raw_line(lowerer, `  br label %${cond_label}`); raw_line(lowerer,cond_label+":")
        string index=next_register(lowerer); raw_line(lowerer, `  ${index} = load i64, ptr ${index_slot}`); string more=next_register(lowerer); raw_line(lowerer, `  ${more} = icmp ult i64 ${index}, ${length}`); raw_line(lowerer, `  br i1 ${more}, label %${body_label}, label %${end_label}`); raw_line(lowerer,body_label+":")
        string source_element_address=next_register(lowerer); raw_line(lowerer, `  ${source_element_address} = getelementptr ptr, ptr ${source_data}, i64 ${index}`); string source_element=next_register(lowerer); raw_line(lowerer, `  ${source_element} = load ptr, ptr ${source_element_address}`)
        string stored_slot=next_register(lowerer); raw_line(lowerer, `  ${stored_slot} = alloca ptr`)
        string is_null=next_register(lowerer); raw_line(lowerer, `  ${is_null} = icmp eq ptr ${source_element}, null`)
        string null_label=next_label(lowerer,"array.copy.null"); string clone_label=next_label(lowerer,"array.copy.clone"); string store_label=next_label(lowerer,"array.copy.store")
        raw_line(lowerer, `  br i1 ${is_null}, label %${null_label}, label %${clone_label}`); raw_line(lowerer,null_label+":"); raw_line(lowerer, `  store ptr null, ptr ${stored_slot}`); raw_line(lowerer, `  br label %${store_label}`); raw_line(lowerer,clone_label+":")
        IRValue temp; temp.llvm_type="ptr"; temp.value=source_element; temp.type_info=element; IRValue cloned=clone_struct_value(lowerer,temp,element); raw_line(lowerer, `  store ptr ${cloned.value}, ptr ${stored_slot}`); raw_line(lowerer, `  br label %${store_label}`); raw_line(lowerer,store_label+":")
        string stored_element=next_register(lowerer); raw_line(lowerer, `  ${stored_element} = load ptr, ptr ${stored_slot}`)
        string destination_element_address=next_register(lowerer); raw_line(lowerer, `  ${destination_element_address} = getelementptr ptr, ptr ${new_data}, i64 ${index}`); raw_line(lowerer, `  store ptr ${stored_element}, ptr ${destination_element_address}`)
        if lowerer.result.mecc_enabled { raw_line(lowerer, `  call void @clyth_mecc_store(ptr ${new_header}, ptr ${destination_element_address}, ptr ${stored_element})`) }
        string next_index=next_register(lowerer); raw_line(lowerer, `  ${next_index} = add i64 ${index}, 1`); raw_line(lowerer, `  store i64 ${next_index}, ptr ${index_slot}`); raw_line(lowerer, `  br label %${cond_label}`); raw_line(lowerer,end_label+":")
    } else {
        raw_line(lowerer, `  call ptr @memcpy(ptr ${new_data}, ptr ${source_data}, i64 ${bytes})`)
        if lowerer.result.mecc_enabled && semantic_is_pointer(element) {
            string edge_index_slot=next_register(lowerer); raw_line(lowerer, `  ${edge_index_slot} = alloca i64`); raw_line(lowerer, `  store i64 0, ptr ${edge_index_slot}`)
            string edge_cond=next_label(lowerer,"array.edge.cond"); string edge_body=next_label(lowerer,"array.edge.body"); string edge_end=next_label(lowerer,"array.edge.end")
            raw_line(lowerer, `  br label %${edge_cond}`); raw_line(lowerer,edge_cond+":")
            string edge_index=next_register(lowerer); raw_line(lowerer, `  ${edge_index} = load i64, ptr ${edge_index_slot}`); string edge_more=next_register(lowerer); raw_line(lowerer, `  ${edge_more} = icmp ult i64 ${edge_index}, ${length}`); raw_line(lowerer, `  br i1 ${edge_more}, label %${edge_body}, label %${edge_end}`); raw_line(lowerer,edge_body+":")
            string edge_slot=next_register(lowerer); raw_line(lowerer, `  ${edge_slot} = getelementptr ptr, ptr ${new_data}, i64 ${edge_index}`); string edge_target=next_register(lowerer); raw_line(lowerer, `  ${edge_target} = load ptr, ptr ${edge_slot}`); raw_line(lowerer, `  call void @clyth_mecc_store(ptr ${new_header}, ptr ${edge_slot}, ptr ${edge_target})`)
            string edge_next=next_register(lowerer); raw_line(lowerer, `  ${edge_next} = add i64 ${edge_index}, 1`); raw_line(lowerer, `  store i64 ${edge_next}, ptr ${edge_index_slot}`); raw_line(lowerer, `  br label %${edge_cond}`); raw_line(lowerer,edge_end+":")
        }
    }
    string data_slot=next_register(lowerer); raw_line(lowerer, `  ${data_slot} = getelementptr i8, ptr ${new_header}, i64 0`); raw_line(lowerer, `  store ptr ${new_data}, ptr ${data_slot}`); string new_length_slot=next_register(lowerer); raw_line(lowerer, `  ${new_length_slot} = getelementptr i8, ptr ${new_header}, i64 8`); raw_line(lowerer, `  store i64 ${length}, ptr ${new_length_slot}`)
    result.value=new_header; result.fresh=true; return result
}

IRValue coerce(llvm_lowerer* lowerer, IRValue value, SemanticType* target) {
    if target==null || is_unknown_type(target) {return value}
    string target_ty=llvm_type(lowerer,target)
    if target.kind=="struct" && target.pointer_depth==0 && value.llvm_type=="ptr" && value.type_info!=null && value.type_info.kind=="struct" && value.type_info.pointer_depth==0 {if value.fresh {value.type_info=target; value.fresh=false; return value}; return clone_struct_value(lowerer,value,target)}
    bool target_array = target.kind=="array" || target.array_dimensions.length>0
    bool value_array = value.type_info!=null && (value.type_info.kind=="array" || value.type_info.array_dimensions.length>0)
    if target_array && value.llvm_type=="ptr" && value_array {if value.fresh {value.type_info=target; value.fresh=false; return value}; return clone_array_value(lowerer,value,target)}
    if value.llvm_type==target_ty {value.type_info=target; return value}
    IRValue result; result.llvm_type=target_ty; result.type_info=target
    if target_ty=="void" {result.llvm_type="void"; return result}
    if value.llvm_type=="ptr" && target_ty=="ptr" {result.llvm_type="ptr"; result.value=value.value; return result}
    string reg=next_register(lowerer)
    if bootstrap_string_starts_with(value.llvm_type,"i")!=0 && bootstrap_string_starts_with(target_ty,"i")!=0 {
        int64 from_bits=bootstrap_decimal_int(bootstrap_string_slice(value.llvm_type,1,bootstrap_string_length(value.llvm_type)-1)); int64 to_bits=bootstrap_decimal_int(bootstrap_string_slice(target_ty,1,bootstrap_string_length(target_ty)-1)); string op="trunc"
        if from_bits<to_bits {op="sext"; if is_unsigned_type(value.type_info) {op="zext"}}
        raw_line(lowerer, `  ${reg} = ${op} ${value.llvm_type} ${value.value} to ${target_ty}`); result.value=reg; return result
    }
    if value.llvm_type=="ptr" && bootstrap_string_starts_with(target_ty,"i")!=0 {raw_line(lowerer, `  ${reg} = ptrtoint ptr ${value.value} to ${target_ty}`); result.value=reg; return result}
    if bootstrap_string_starts_with(value.llvm_type,"i")!=0 && target_ty=="ptr" {raw_line(lowerer, `  ${reg} = inttoptr ${value.llvm_type} ${value.value} to ptr`); result.llvm_type="ptr"; result.value=reg; return result}
    bool target_float = target_ty=="float" || target_ty=="double"
    if bootstrap_string_starts_with(value.llvm_type,"i")!=0 && target_float {string op="sitofp"; if is_unsigned_type(value.type_info){op="uitofp"}; raw_line(lowerer, `  ${reg} = ${op} ${value.llvm_type} ${value.value} to ${target_ty}`); result.value=reg; return result}
    bool value_float = value.llvm_type=="float" || value.llvm_type=="double"
    if value_float && bootstrap_string_starts_with(target_ty,"i")!=0 {string op="fptosi"; if is_unsigned_type(target){op="fptoui"}; raw_line(lowerer, `  ${reg} = ${op} ${value.llvm_type} ${value.value} to ${target_ty}`); result.value=reg; return result}
    return zero_value(lowerer,target)
}

bool is_unsigned_type(SemanticType* type_info) { if type_info==null {return false}; return bootstrap_string_starts_with(type_info.name,"uint")!=0 || type_info.name=="uintptr" || type_info.name=="char" || type_info.kind=="bool" || type_info.name=="bool" }

IRValue to_bool(llvm_lowerer* lowerer, IRValue value) {
    if value.llvm_type=="i1" {return value}; string reg=next_register(lowerer)
    if value.llvm_type=="ptr" {raw_line(lowerer, `  ${reg} = icmp ne ptr ${value.value}, null`)}
    else if value.llvm_type=="float" || value.llvm_type=="double" {raw_line(lowerer, `  ${reg} = fcmp one ${value.llvm_type} ${value.value}, 0.0`)}
    else {raw_line(lowerer, `  ${reg} = icmp ne ${value.llvm_type} ${value.value}, 0`)}
    SemanticType* sem=new SemanticType(); sem.kind="bool"; sem.name="bool"; IRValue result; result.llvm_type="i1"; result.value=reg; result.type_info=sem; return result
}

string address_of(llvm_lowerer* lowerer, Expr expression) {
    BootstrapAssignmentAddressResult result = assignment_address(lowerer, expression)
    if !result.ok || result.address == "" { return "null" }
    return result.address
}
BootstrapAssignmentAddressResult assignment_address(llvm_lowerer* lowerer, Expr expression) {
    BootstrapAssignmentAddressOwnerResult owned = assignment_address_with_owner(lowerer, expression)
    BootstrapAssignmentAddressResult result
    result.address = owned.address; result.type_info = owned.type_info; result.ok = owned.ok
    return result
}

BootstrapAssignmentAddressOwnerResult assignment_address_with_owner(llvm_lowerer* lowerer, Expr expression) {
    BootstrapAssignmentAddressOwnerResult result; result.address=""; result.type_info=lowerer.result.expression_types[expression]; result.owner="null"; result.ok=false
    if expression.kind == EXPR_IDENTIFIER && expression.identifier != null {
        IdentifierExpr* item = expression.identifier
        ir_local local = lowerer.locals[item.Name]
        if local.address != "" { result.address=local.address; result.type_info=local.type_info; result.ok=true; return result }
        ir_local global = lowerer.globals[item.Name]
        if global.address != "" { result.address=global.address; result.type_info=global.type_info; result.ok=true; return result }
        if lowerer.receiver != null {
            Symbol* field = lowerer.receiver.fields[item.Name]
            if field != null { string owner=lowerer.locals["this"].address; result.address=field_address(lowerer,owner,lowerer.receiver,item.Name); result.type_info=field.type_info; result.owner=owner; result.ok=true; return result }
        }
    } else if expression.kind == EXPR_MEMBER && expression.member != null {
        MemberExpr* item = expression.member
        IRValue object = emit_expr(lowerer, item.Object)
        SemanticType* object_sem = specialize_type(lowerer, lowerer.result.expression_types[item.Object])
        if object_sem == null || object_sem.kind == "unknown" { object_sem = specialize_type(lowerer, infer_expression_type(lowerer, item.Object)) }
        if object_sem != null && (object_sem.pointer_depth > 0 || object_sem.kind == "pointer") {
            string non_null=next_register(lowerer); raw_line(lowerer, `  ${non_null} = icmp ne ptr ${object.value}, null`); emit_checked_failure(lowerer,non_null,"null_reference","null pointer member access","nullref")
        }
        StructInfo* info = lowerer.struct_info[base_type_name(object_sem)]
        if info != null { Symbol* field=info.fields[item.Name]; if field!=null {result.address=field_address(lowerer,object.value,info,item.Name); result.type_info=field.type_info; result.owner=object.value; result.ok=true; return result} }
    } else if expression.kind == EXPR_INDEX && expression.index != null {
        IndexExpr* item = expression.index
        IRValue object=emit_expr(lowerer,item.Object)
        SemanticType* integer_type=new SemanticType(); integer_type.kind="integer"; integer_type.name="int64"
        IRValue index=coerce(lowerer,emit_expr(lowerer,item.Index),integer_type)
        SemanticType* object_sem=specialize_type(lowerer,lowerer.result.expression_types[item.Object])
        if object_sem==null || object_sem.kind=="unknown" {object_sem=specialize_type(lowerer,infer_expression_type(lowerer,item.Object))}
        emit_index_bounds_check(lowerer,item,object,index,object_sem)
        SemanticType* sem=specialize_type(lowerer,lowerer.result.expression_types[expression]); string ty=llvm_type(lowerer,sem); string data=object.value
        if object_sem==null || object_sem.kind!="string" || object_sem.array_dimensions.length!=0 {data=array_data_pointer(lowerer,object.value)}
        string address=next_register(lowerer); raw_line(lowerer, `  ${address} = getelementptr ${ty}, ptr ${data}, i64 ${index.value}`)
        result.address=address; result.type_info=sem; result.owner=object.value; result.ok=true; return result
    } else if expression.kind == EXPR_UNARY && expression.unary != null && expression.unary.Operator == "*" {
        UnaryExpr* item=expression.unary; IRValue pointer=emit_expr(lowerer,item.Operand)
        if pointer.llvm_type!="ptr" {return result}
        string non_null=next_register(lowerer); raw_line(lowerer, `  ${non_null} = icmp ne ptr ${pointer.value}, null`); emit_checked_failure(lowerer,non_null,"null_reference","null pointer dereference","nullref")
        result.address=pointer.value; result.type_info=specialize_type(lowerer,lowerer.result.expression_types[expression]); result.owner="null"; result.ok=true; return result
    }
    return result
}

void emit_index_bounds_check(llvm_lowerer* lowerer, IndexExpr* item, IRValue object, IRValue index, SemanticType* object_sem) {
    if object_sem == null || lowerer.result.index_safety[item.node] == "proven_safe" { return }
    string length = ""
    if object_sem.kind == "string" && object_sem.array_dimensions.length == 0 {
        string length_reg = next_register(lowerer)
        raw_line(lowerer, `  ${length_reg} = call i64 @strlen(ptr ${object.value})`)
        length = length_reg
    } else if object_sem.array_dimensions.length > 0 || object_sem.kind == "array" {
        if object_sem.array_dimensions.length > 0 && !object_sem.array_dimensions[0].dynamic && object_sem.array_dimensions[0].size != "" {
            length = object_sem.array_dimensions[0].size
        } else {
            string length_slot = next_register(lowerer)
            raw_line(lowerer, `  ${length_slot} = getelementptr i8, ptr ${object.value}, i64 8`)
            string length_reg = next_register(lowerer)
            raw_line(lowerer, `  ${length_reg} = load i64, ptr ${length_slot}`)
            length = length_reg
        }
    }
    if length == "" { return }
    string in_bounds = next_register(lowerer)
    raw_line(lowerer, `  ${in_bounds} = icmp ult i64 ${index.value}, ${length}`)
    emit_checked_failure(lowerer, in_bounds, "bounds_error", "array or string index out of bounds", "bounds")
}

string array_data_pointer(llvm_lowerer* lowerer, string header) { string slot=next_register(lowerer); raw_line(lowerer, `  ${slot} = getelementptr i8, ptr ${header}, i64 0`); string data=next_register(lowerer); raw_line(lowerer, `  ${data} = load ptr, ptr ${slot}`); return data }

int64 llvm_storage_size(llvm_lowerer* lowerer, string llvm_type_name) { if llvm_type_name=="i1"||llvm_type_name=="i8" {return 1}; if llvm_type_name=="i16" {return 2}; if llvm_type_name=="i32"||llvm_type_name=="float" {return 4}; return 8 }

int64 align_up(int64 value, int64 alignment) { if alignment<=1 {return value}; return ((value+alignment-1)/alignment)*alignment }

int64 semantic_storage_size(llvm_lowerer* lowerer, SemanticType* type_info) { return llvm_storage_size(lowerer,llvm_type(lowerer,type_info)) }

int64 semantic_alignment(llvm_lowerer* lowerer, SemanticType* type_info) { int64 size=semantic_storage_size(lowerer,type_info); if size>8{return 8}; if size<1{return 1}; return size }

int64 struct_field_offset(llvm_lowerer* lowerer, StructInfo* info, string field_name) { if info==null{return 0}; int64 offset=0; string[] names=info.field_order; if names.length==0 {names=info.fields.keys(); sort_strings(names)}; int64 i=0; while i<names.length {Symbol* field=info.fields[names[i]]; if field!=null {int64 alignment=semantic_alignment(lowerer,field.type_info); offset=align_up(offset,alignment); if names[i]==field_name{return offset}; offset+=semantic_storage_size(lowerer,field.type_info)}; i+=1}; return offset }

int64 struct_storage_size(llvm_lowerer* lowerer, StructInfo* info) { if info==null||info.fields.length==0{return 1}; int64 offset=0; int64 max_alignment=1; string[] names=info.field_order; if names.length==0 {names=info.fields.keys(); sort_strings(names)}; int64 i=0; while i<names.length {Symbol* field=info.fields[names[i]]; if field!=null {int64 alignment=semantic_alignment(lowerer,field.type_info); if alignment>max_alignment{max_alignment=alignment}; offset=align_up(offset,alignment); offset+=semantic_storage_size(lowerer,field.type_info)}; i+=1}; return align_up(offset,max_alignment) }

void initialize_struct_fields(llvm_lowerer* lowerer, string object, StructInfo* info) {
    if info==null {return}; int64 i=0
    while i<info.field_order.length {
        string name=info.field_order[i]; Symbol* field=info.fields[name]
        if field!=null {
            SemanticType* field_type=specialize_type(lowerer,field.type_info); string address=field_address(lowerer,object,info,name)
            if field_type.array_dimensions.length>0 || field_type.kind=="array" {
                int64 count=0; if field_type.array_dimensions.length>0 && !field_type.array_dimensions[0].dynamic {count=bootstrap_decimal_int(field_type.array_dimensions[0].size)}
                SemanticType* element=array_element_type(lowerer,field_type); int64 element_size=semantic_storage_size(lowerer,element); string header=next_register(lowerer); raw_line(lowerer, `  ${header} = call ptr @calloc(i64 1, i64 16)` )
                if count>0 {string data=next_register(lowerer); raw_line(lowerer, `  ${data} = call ptr @calloc(i64 ${count}, i64 ${element_size})`); string data_slot=next_register(lowerer); raw_line(lowerer, `  ${data_slot} = getelementptr i8, ptr ${header}, i64 0`); raw_line(lowerer, `  store ptr ${data}, ptr ${data_slot}`)}
                string length_slot=next_register(lowerer); raw_line(lowerer, `  ${length_slot} = getelementptr i8, ptr ${header}, i64 8`); raw_line(lowerer, `  store i64 ${count}, ptr ${length_slot}`); raw_line(lowerer, `  store ptr ${header}, ptr ${address}`)
            } else if field_type.kind=="struct" && field_type.pointer_depth==0 {
                StructInfo* nested_info=lowerer.struct_info[base_type_name(field_type)]; if nested_info!=null {string nested=next_register(lowerer); int64 size=struct_storage_size(lowerer,nested_info); raw_line(lowerer, `  ${nested} = call ptr @calloc(i64 1, i64 ${size})`); initialize_struct_fields(lowerer,nested,nested_info); raw_line(lowerer, `  store ptr ${nested}, ptr ${address}`)}
            }
        }; i+=1
    }
}

string field_address(llvm_lowerer* lowerer, string object, StructInfo* info, string field_name) { int64 offset=struct_field_offset(lowerer,info,field_name); string address=next_register(lowerer); raw_line(lowerer, `  ${address} = getelementptr i8, ptr ${object}, i64 ${offset}`); return address }
IRValue load_receiver_field(llvm_lowerer* lowerer, string name, SemanticType* sem) { ir_local self=lowerer.locals["this"]; if self.address=="" || lowerer.receiver==null {return zero_value(lowerer,sem)}; string address=field_address(lowerer,self.address,lowerer.receiver,name); string ty=llvm_type(lowerer,sem); string value=next_register(lowerer); raw_line(lowerer, `  ${value} = load ${ty}, ptr ${address}`); IRValue result; result.llvm_type=ty; result.value=value; result.type_info=sem; return result }
