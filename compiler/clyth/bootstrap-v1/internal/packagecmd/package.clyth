string setRegistry(bool update, string[] args, Writer out) {
    if args.length != 3 { return "usage: clyth add-registry <name> (--path <directory> | --url <remote-url>)" }
    if args[1] != "--path" && args[1] != "--url" { return "usage: clyth add-registry <name> (--path <directory> | --url <remote-url>)" }
    return bootstrap_set_registry(update, args[0], args[1], args[2], out)
}

