import lexer.clyth
/**
 * Prints the intentionally small Stage 1 command-line surface.
 *
 * @returns: void
 */
void print_help() {
    println("usage: clyth-bootstrap -c <source.clyth> [-o <binary>] [--stage0 <compiler>] [--module-store <path>] [--emit-ir-only]")
}

/**
 * Executes the frozen Stage 0 backend against the independently managed store.
 * This is the minimum viable Stage 1 compiler and will be replaced piece by
 * piece as the native 0.6.0 frontend becomes self-hosting.
 *
 * @arg: string - source file
 * @arg: string - output path
 * @arg: string - frozen Stage 0 compiler path
 * @arg: string - active runtime module store
 * @arg: bool - stop after LLVM IR emission
 * @returns: int32 - delegated compiler exit status
 */
int32 compile_source(string source, string output, string stage0, string module_store, bool emit_ir_only) {
    if source_is_valid(source) == false {
        eprint("invalid Clyth source: ")
        eprintln(source)
        return 2
    }

    string command = ""
    if module_store == "" {
        command = `${stage0} -c ${source} -o ${output}`
    } else {
        command = `CLYTH_RUNTIME_DIR=${module_store} ${stage0} -c ${source} -o ${output}`
    }
    if emit_ir_only { command = `${command} --emit-ir-only` }
    return bash(command)
}
