int32 DECL_MECC_CONFIG = 1
int32 DECL_ERROR_TYPE = 2
int32 DECL_IMPORT = 3
int32 DECL_FUNCTION = 4
int32 DECL_STRUCT = 5
int32 DECL_ENUM = 6
int32 DECL_METHOD_BLOCK = 7
int32 DECL_PROTOCOL = 8
int32 DECL_GLOBAL_VAR = 9

int32 STMT_BLOCK = 1
int32 STMT_MECC_CONFIG = 2
