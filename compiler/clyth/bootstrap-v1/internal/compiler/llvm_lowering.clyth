        string address=next_register(lowerer); raw_line(lowerer, `  ${address} = getelementptr ${elem_ty}, ptr ${data}, i64 ${i}`); raw_line(lowerer, `  store ${elem_ty} ${value.value}, ptr ${address}`); i+=1
    }
    string header=next_register(lowerer); raw_line(lowerer, `  ${header} = call ptr @malloc(i64 16)`); string data_slot=next_register(lowerer); raw_line(lowerer, `  ${data_slot} = getelementptr i8, ptr ${header}, i64 0`); raw_line(lowerer, `  store ptr ${data}, ptr ${data_slot}`); string length_slot=next_register(lowerer); raw_line(lowerer, `  ${length_slot} = getelementptr i8, ptr ${header}, i64 8`); raw_line(lowerer, `  store i64 ${count}, ptr ${length_slot}`)
    IRValue result; result.llvm_type="ptr"; result.value=header; result.type_info=array_sem; result.fresh=true; return result
}

BootstrapVariadicPackResult emit_variadic_pack(llvm_lowerer* lowerer, Expr[] expressions, SemanticType* element_type, bool heterogeneous) {
    BootstrapVariadicPackResult result; result.ok=true; int64 count=expressions.length; int64 storage_count=count; if storage_count==0 {storage_count=1}
    if heterogeneous {
        string data=next_register(lowerer); raw_line(lowerer, `  ${data} = alloca [${storage_count*2} x i64]`); int64 i=0
        while i<expressions.length {IRValue value=emit_expr(lowerer,expressions[i]); if value.fresh&&(is_value_aggregate(value.type_info)||(value.type_info!=null&&value.type_info.kind=="string")) {int64 n=result.temporaries.length; result.temporaries = array<IRValue>(result.temporaries, n+1); result.temporaries[n]=value}; string type_slot=next_register(lowerer); raw_line(lowerer, `  ${type_slot} = getelementptr [${storage_count*2} x i64], ptr ${data}, i64 0, i64 ${i*2}`); raw_line(lowerer, `  store i64 ${stable_variadic_type_id(type_name(value.type_info))}, ptr ${type_slot}`); string payload_slot=next_register(lowerer); raw_line(lowerer, `  ${payload_slot} = getelementptr [${storage_count*2} x i64], ptr ${data}, i64 0, i64 ${i*2+1}`); string payload=variadic_payload_i64(lowerer,value); raw_line(lowerer, `  store i64 ${payload}, ptr ${payload_slot}`); i+=1}
        string header=emit_stack_array_header(lowerer,data,count); SemanticType* array_type=new SemanticType(); array_type.kind="array"; array_type.name="auto_variadic"; array_type.array_dimensions = array<SemanticArrayDimension>(array_type.array_dimensions, 1); array_type.array_dimensions[0].dynamic=true; result.value.llvm_type="ptr"; result.value.value=header; result.value.type_info=array_type; return result
    }
    SemanticType* target=specialize_type(lowerer,element_type); string elem_ty=llvm_type(lowerer,target); string data=next_register(lowerer); raw_line(lowerer, `  ${data} = alloca [${storage_count} x ${elem_ty}]`); int64 i=0
    while i<expressions.length {IRValue value=emit_expr(lowerer,expressions[i]); if target!=null&&target.kind=="string"&&(value.type_info==null||value.type_info.kind!="string") {value=emit_to_string(lowerer,value)} else {value=coerce(lowerer,value,target)}; if is_value_aggregate(target)||(target!=null&&target.kind=="string"&&value.fresh) {int64 n=result.temporaries.length; result.temporaries = array<IRValue>(result.temporaries, n+1); result.temporaries[n]=value}; string slot=next_register(lowerer); raw_line(lowerer, `  ${slot} = getelementptr [${storage_count} x ${elem_ty}], ptr ${data}, i64 0, i64 ${i}`); raw_line(lowerer, `  store ${elem_ty} ${value.value}, ptr ${slot}`); i+=1}
    string header=emit_stack_array_header(lowerer,data,count); SemanticType* array_type=clone_type(target); if array_type==null {array_type=new SemanticType(); array_type.kind="unknown"}; array_type.kind="array"; array_type.array_dimensions = array<SemanticArrayDimension>(array_type.array_dimensions, 1); array_type.array_dimensions[0].dynamic=true; result.value.llvm_type="ptr"; result.value.value=header; result.value.type_info=array_type; return result
}

string emit_stack_array_header(llvm_lowerer* lowerer, string data, int64 count) {
    string header = next_register(lowerer)
    raw_line(lowerer, `  ${header} = alloca [16 x i8]`)
    string data_slot = next_register(lowerer)
    raw_line(lowerer, `  ${data_slot} = getelementptr i8, ptr ${header}, i64 0`)
    raw_line(lowerer, `  store ptr ${data}, ptr ${data_slot}`)
    string length_slot = next_register(lowerer)
    raw_line(lowerer, `  ${length_slot} = getelementptr i8, ptr ${header}, i64 8`)
    raw_line(lowerer, `  store i64 ${count}, ptr ${length_slot}`)
    return header
}

uint64 stable_variadic_type_id(string name) { uint64 hash=1469598103934665603; int64 i=0; while i<bootstrap_string_length(name) { string ch=bootstrap_string_slice(name,i,1); hash = hash * 1099511628211 + ch[0]; i+=1 }; return hash }

string variadic_payload_i64(llvm_lowerer* lowerer, IRValue value) {
    if value.value == "" { return "0" }
    if value.llvm_type == "ptr" { string converted=next_register(lowerer); raw_line(lowerer, `  ${converted} = ptrtoint ptr ${value.value} to i64`); return converted }
    if value.llvm_type == "double" { string converted=next_register(lowerer); raw_line(lowerer, `  ${converted} = bitcast double ${value.value} to i64`); return converted }
    if value.llvm_type == "float" { string bits=next_register(lowerer); raw_line(lowerer, `  ${bits} = bitcast float ${value.value} to i32`); string converted=next_register(lowerer); raw_line(lowerer, `  ${converted} = zext i32 ${bits} to i64`); return converted }
    if bootstrap_string_starts_with(value.llvm_type, "i") != 0 {
        int64 bits=bootstrap_decimal_int(bootstrap_string_slice(value.llvm_type,1,bootstrap_string_length(value.llvm_type)-1)); if bits==64 {return value.value}
        string converted=next_register(lowerer); string op="sext"; if is_unsigned_type(value.type_info)||bits==1 {op="zext"}; raw_line(lowerer, `  ${converted} = ${op} ${value.llvm_type} ${value.value} to i64`); return converted
    }
    return "0"
}

IRValue emit_to_string(llvm_lowerer* lowerer, IRValue value) {
    SemanticType* string_type=new SemanticType(); string_type.kind="string"; string_type.name="string"
    if value.type_info!=null && value.type_info.kind=="string" {value.type_info=string_type; return value}
    if value.type_info!=null && value.type_info.kind=="bool" && value.llvm_type=="i1" {
        IRValue true_value=static_string_value(lowerer,"true",string_type); IRValue false_value=static_string_value(lowerer,"false",string_type); string selected=next_register(lowerer)
        raw_line(lowerer, `  ${selected} = select i1 ${value.value}, ptr ${true_value.value}, ptr ${false_value.value}`)
        IRValue result; result.llvm_type="ptr"; result.value=selected; result.type_info=string_type; return result
    }
    if value.type_info!=null && value.type_info.kind=="struct" {
        StructInfo* info=lowerer.struct_info[base_type_name(value.type_info)]
        if info!=null {Symbol* method=info.methods["to_string"]; if method!=null&&method.type_info!=null&&method.type_info.callable!=null&&method.type_info.callable.parameters.length==0 {string reg=next_register(lowerer); raw_line(lowerer, `  ${reg} = call ptr @${llvm_method_name(info.name,"to_string")}(ptr ${value.value})`); IRValue result; result.llvm_type="ptr"; result.value=reg; result.type_info=string_type; return result}}
    }
    string format="%lld"; IRValue argument=value
    if value.type_info!=null&&is_unsigned_type(value.type_info) {format="%llu"}
    if value.llvm_type=="float"||value.llvm_type=="double" {format="%g"; if value.llvm_type=="float" {string promoted=next_register(lowerer); raw_line(lowerer, `  ${promoted} = fpext float ${value.value} to double`); argument.llvm_type="double"; argument.value=promoted; argument.type_info=new SemanticType(); argument.type_info.kind="float"; argument.type_info.name="float64"}}
    else if value.llvm_type=="ptr" {format="%p"} else if value.type_info!=null&&value.type_info.kind=="char" {format="%c"}
    IRValue format_value=static_string_value(lowerer,format,string_type); string required32=next_register(lowerer); raw_line(lowerer, `  ${required32} = call i32 (ptr, i64, ptr, ...) @snprintf(ptr null, i64 0, ptr ${format_value.value}, ${argument.llvm_type} ${argument.value})`)
    string required64=next_register(lowerer); raw_line(lowerer, `  ${required64} = sext i32 ${required32} to i64`); string capacity=next_register(lowerer); raw_line(lowerer, `  ${capacity} = add i64 ${required64}, 1`); string buffer=next_register(lowerer); raw_line(lowerer, `  ${buffer} = call ptr @malloc(i64 ${capacity})`); raw_line(lowerer, `  call i32 (ptr, i64, ptr, ...) @snprintf(ptr ${buffer}, i64 ${capacity}, ptr ${format_value.value}, ${argument.llvm_type} ${argument.value})`)
    IRValue result; result.llvm_type="ptr"; result.value=buffer; result.type_info=string_type; result.fresh=true; return result
}

string constant_initializer(llvm_lowerer* lowerer, Expr expression, SemanticType* target) {
    if expression.kind==EXPR_LITERAL && expression.literal!=null {
        LiteralExpr* literal=expression.literal
        if literal.Kind=="integer" { string out=""; int64 i=0; while i<bootstrap_string_length(literal.Raw) {string ch=bootstrap_string_slice(literal.Raw,i,1); if ch!="_" {out=out+ch}; i+=1}; return out }
        if literal.Kind=="bool" {if literal.Raw=="true" {return "1"}; return "0"}
        if literal.Kind=="float" {return literal.Raw}
        if literal.Kind=="null" {return "null"}
        if literal.Kind=="string" {
            string text=bootstrap_unquote_literal(literal.Raw)
            int64 index=lowerer.strings.length
            int64 old=lowerer.strings.length
            lowerer.strings=array<string>(lowerer.strings,old+1)
            lowerer.strings[old]=text
            int64 n=bootstrap_string_length(text)+1
            return `getelementptr inbounds ([${n} x i8], ptr @.clyth.str.${index}, i64 0, i64 0)`
        }
    }
    return zero_value(lowerer,target).value
}

IRValue static_string_value(llvm_lowerer* lowerer, string text, SemanticType* type_info) {
    int64 index = lowerer.strings.length
    int64 old = lowerer.strings.length
    lowerer.strings = array<string>(lowerer.strings, old + 1)
    lowerer.strings[old] = text
    int64 n = bootstrap_string_length(text) + 1
    IRValue result
    result.llvm_type = "ptr"
    result.value = `getelementptr inbounds ([${n} x i8], ptr @.clyth.str.${index}, i64 0, i64 0)`
    result.type_info = type_info
    return result
}

struct interpolation_piece {
	string literal
	string expression
}

interpolation_piece[] split_interpolated_string(string raw) {
    string text = raw
    int64 raw_length = bootstrap_string_length(text)
    if raw_length >= 2 && bootstrap_string_slice(text,0,1)=="`" && bootstrap_string_slice(text,raw_length-1,1)=="`" { text=bootstrap_string_slice(text,1,raw_length-2) }
    interpolation_piece[] pieces
    int64 start=0; int64 i=0; int64 n=bootstrap_string_length(text)
    while i+1<n {
        if bootstrap_string_slice(text,i,2)!="${" { i+=1; continue }
        if i>start { interpolation_piece literal_piece; literal_piece.literal=bootstrap_string_slice(text,start,i-start); int64 count=pieces.length; pieces = array<interpolation_piece>(pieces, count+1); pieces[count]=literal_piece }
        int64 depth=1; int64 j=i+2; string quote=""
        while j<n {
            string c=bootstrap_string_slice(text,j,1)
            if quote!="" {
                if c=="\\" { j+=2; continue }
                if c==quote { quote="" }
                j+=1; continue
            }
            if c=="'" || c=="\"" { quote=c; j+=1; continue }
            if c=="{" {depth+=1} else if c=="}" {depth-=1; if depth==0 {break}}
            j+=1
        }
        if j>=n { interpolation_piece tail; tail.literal=bootstrap_string_slice(text,i,n-i); int64 count=pieces.length; pieces = array<interpolation_piece>(pieces, count+1); pieces[count]=tail; return pieces }
        interpolation_piece expression_piece; expression_piece.expression=bootstrap_string_slice(text,i+2,j-i-2); int64 count=pieces.length; pieces = array<interpolation_piece>(pieces, count+1); pieces[count]=expression_piece
        i=j+1; start=j+1
    }
    if start<n { interpolation_piece tail; tail.literal=bootstrap_string_slice(text,start,n-start); int64 count=pieces.length; pieces = array<interpolation_piece>(pieces, count+1); pieces[count]=tail }
    return pieces
}

BootstrapInterpolationArgumentResult interpolation_argument(llvm_lowerer* lowerer, IRValue value) {
    BootstrapInterpolationArgumentResult result; result.value=value; result.llvm_type="%p"; result.ok=true
    if value.type_info!=null && value.type_info.name=="string" {result.llvm_type="%s"; return result}
    if value.llvm_type=="ptr" {return result}
    if value.llvm_type=="float" {string reg=next_register(lowerer); raw_line(lowerer, `  ${reg} = fpext float ${value.value} to double`); result.llvm_type="%g"; result.value.llvm_type="double"; result.value.value=reg; result.value.type_info=new SemanticType(); result.value.type_info.kind="float"; result.value.type_info.name="float64"; return result}
    if value.llvm_type=="double" {result.llvm_type="%g"; return result}
    if value.llvm_type=="i1" {SemanticType* target=new SemanticType(); target.kind="integer"; target.name="int32"; result.llvm_type="%d"; result.value=coerce(lowerer,value,target); return result}
    if bootstrap_string_starts_with(value.llvm_type,"i")!=0 {SemanticType* target=new SemanticType(); target.kind="integer"; if is_unsigned_type(value.type_info) {result.llvm_type="%llu"; target.name="uint64"} else {result.llvm_type="%lld"; target.name="int64"}; result.value=coerce(lowerer,value,target); return result}
    return result
}

SemanticType* infer_expression_type(llvm_lowerer* lowerer, Expr expression) {
    if expression.kind==0 {SemanticType* unknown=new SemanticType(); unknown.kind="unknown"; return unknown}
    SemanticType* existing=lowerer.result.expression_types[expression]; if existing!=null {return specialize_type(lowerer,existing)}
    if expression.kind==EXPR_LITERAL {return literal_type(lowerer,bootstrap_as_literal_expr(expression))}
    if expression.kind==EXPR_IDENTIFIER {IdentifierExpr* item=bootstrap_as_identifier_expr(expression); ir_local local=lowerer.locals[item.Name]; if local.type_info!=null{return local.type_info}; ir_local global=lowerer.globals[item.Name]; if global.type_info!=null{return global.type_info}; if lowerer.receiver!=null {Symbol* field=lowerer.receiver.fields[item.Name]; if field!=null{return field.type_info}}; Symbol* symbol=lowerer.result.root_namespace.symbols[item.Name]; if symbol!=null{return symbol.type_info}}
    else if expression.kind==EXPR_INDEX {IndexExpr* item=bootstrap_as_index_expr(expression); SemanticType* object=infer_expression_type(lowerer,item.Object); if object!=null&&object.name=="string" {SemanticType* result=new SemanticType(); result.kind="char"; result.name="char"; return result}; return array_element_type(lowerer,object)}
    else if expression.kind==EXPR_MEMBER {MemberExpr* item=bootstrap_as_member_expr(expression); if item.Object.kind==EXPR_IDENTIFIER {IdentifierExpr* identifier=bootstrap_as_identifier_expr(item.Object); Symbol* enum_symbol=lookup_type_symbol(lowerer,lowerer.result.root_namespace,identifier.Name,Map<Namespace*, bool>()); int64 imported_enum_value=0; if enum_member_value(enum_symbol,item.Name,&imported_enum_value){return clone_type(enum_symbol.type_info)}}; SemanticType* object=infer_expression_type(lowerer,item.Object); if item.Name=="length"||item.Name=="capacity" {SemanticType* result=new SemanticType(); result.kind="integer"; result.name="int64"; return result}; StructInfo* info=lowerer.struct_info[base_type_name(object)]; if info!=null {Symbol* field=info.fields[item.Name]; if field!=null{return field.type_info}}}
    else if expression.kind==EXPR_UNARY {UnaryExpr* item=bootstrap_as_unary_expr(expression); SemanticType* operand=infer_expression_type(lowerer,item.Operand); if item.Operator=="!" {SemanticType* result=new SemanticType(); result.kind="bool"; result.name="bool"; return result}; return operand}
    else if expression.kind==EXPR_BINARY {BinaryExpr* item=bootstrap_as_binary_expr(expression); if item.Operator=="=="||item.Operator=="!="||item.Operator=="<"||item.Operator=="<="||item.Operator==">"||item.Operator==">="||item.Operator=="&&"||item.Operator=="||" {SemanticType* result=new SemanticType(); result.kind="bool"; result.name="bool"; return result}; return infer_expression_type(lowerer,item.Left)}
    else if expression.kind==EXPR_CALL {CallExpr* item=bootstrap_as_call_expr(expression); SemanticType* callee=infer_expression_type(lowerer,item.Callee); if callee!=null&&callee.callable!=null{return callee.callable.return_type}}
    else if expression.kind==EXPR_CAST {CastExpr* item=bootstrap_as_cast_expr(expression); return resolve_ref(lowerer,item.Type)}
    SemanticType* unknown=new SemanticType(); unknown.kind="unknown"; return unknown
}

void annotate_expression_types(llvm_lowerer* lowerer, Expr expression) {
    if expression.kind==0 {return}
    if expression.kind==EXPR_INDEX {IndexExpr* item=bootstrap_as_index_expr(expression); annotate_expression_types(lowerer,item.Object); annotate_expression_types(lowerer,item.Index)}
    else if expression.kind==EXPR_MEMBER {annotate_expression_types(lowerer,bootstrap_as_member_expr(expression).Object)}
    else if expression.kind==EXPR_UNARY {annotate_expression_types(lowerer,bootstrap_as_unary_expr(expression).Operand)}
    else if expression.kind==EXPR_BINARY {BinaryExpr* item=bootstrap_as_binary_expr(expression); annotate_expression_types(lowerer,item.Left); annotate_expression_types(lowerer,item.Right)}
    else if expression.kind==EXPR_CALL {CallExpr* item=bootstrap_as_call_expr(expression); annotate_expression_types(lowerer,item.Callee); int64 i=0; while i<item.Arguments.length {annotate_expression_types(lowerer,item.Arguments[i]); i+=1}}
    else if expression.kind==EXPR_CAST {annotate_expression_types(lowerer,bootstrap_as_cast_expr(expression).Value)}
    lowerer.result.expression_types[expression]=infer_expression_type(lowerer,expression)
}

IRValue emit_interpolated_string(llvm_lowerer* lowerer, LiteralExpr* literal, SemanticType* type_info) {
    interpolation_piece[] pieces=split_interpolated_string(literal.Raw); string format=""; IRValue[] arguments; int64 i=0
    while i<pieces.length {
        interpolation_piece piece=pieces[i]
        if piece.literal!="" {int64 j=0; while j<bootstrap_string_length(piece.literal) {string ch=bootstrap_string_slice(piece.literal,j,1); if ch=="%" {format = format + "%%"} else {format = format + ch}; j+=1}; i+=1; continue}
        ExpressionParseResult parsed=ParseExpression(piece.expression)
        if parsed.expression.kind==0||parsed.parseErrors.length!=0||parsed.lexErrors.length!=0 {format = format + "<invalid-interpolation>"; i+=1; continue}
        annotate_expression_types(lowerer,parsed.expression); IRValue value=emit_expr(lowerer,parsed.expression); BootstrapInterpolationArgumentResult promoted=interpolation_argument(lowerer,value); format = format + promoted.llvm_type; int64 n=arguments.length; arguments = array<IRValue>(arguments, n+1); arguments[n]=promoted.value; i+=1
    }
    SemanticType* string_type=new SemanticType(); string_type.kind="string"; string_type.name="string"; IRValue format_value=static_string_value(lowerer,format,string_type); string[] arg_text; i=0
    while i<arguments.length {int64 n=arg_text.length; arg_text = array<string>(arg_text, n+1); arg_text[n]=arguments[i].llvm_type+" "+arguments[i].value; i+=1}
    string suffix=""; if arg_text.length>0 {suffix=", "+join_llvm_strings(arg_text,", ")}
    string required32=next_register(lowerer); raw_line(lowerer, `  ${required32} = call i32 (ptr, i64, ptr, ...) @snprintf(ptr null, i64 0, ptr ${format_value.value}${suffix})`); string required64=next_register(lowerer); raw_line(lowerer, `  ${required64} = sext i32 ${required32} to i64`); string capacity=next_register(lowerer); raw_line(lowerer, `  ${capacity} = add i64 ${required64}, 1`); string buffer=next_register(lowerer); raw_line(lowerer, `  ${buffer} = call ptr @malloc(i64 ${capacity})`); raw_line(lowerer, `  call i32 (ptr, i64, ptr, ...) @snprintf(ptr ${buffer}, i64 ${capacity}, ptr ${format_value.value}${suffix})`)
    IRValue result; result.llvm_type="ptr"; result.value=buffer; result.type_info=type_info; result.fresh=true; return result
}

SemanticType* literal_type(llvm_lowerer* lowerer, LiteralExpr* literal) { SemanticType* result=new SemanticType(); if literal==null {result.kind="unknown"; return result}; if literal.Kind=="integer" {result.kind="integer"; result.name="int64"; result.untyped_literal=true} else if literal.Kind=="float" {result.kind="float"; result.name="float64"; result.untyped_literal=true} else if literal.Kind=="bool" {result.kind="bool"; result.name="bool"} else if literal.Kind=="character" {result.kind="char"; result.name="char"} else if literal.Kind=="string"||literal.Kind=="interpolated_string" {result.kind="string"; result.name="string"} else if literal.Kind=="null" {result.kind="null"; result.name="null"} else {result.kind="unknown"}; return result }

string base_type_name(SemanticType* type_info) { if type_info==null {return ""}; if type_info.generic_args.length>0 {return specialization_name(type_info.name,type_info.generic_args)}; return type_info.name }

bool is_value_aggregate(SemanticType* type_info) { if type_info==null {return false}; if type_info.kind=="array" || type_info.array_dimensions.length>0 {return true}; if semantic_is_pointer(type_info) {return false}; return type_info.kind=="struct" }

BootstrapActiveCatchResult active_catch(llvm_lowerer* lowerer) { BootstrapActiveCatchResult result; if lowerer.catch_stack.length==0 {result.ok=false; return result}; result.context=lowerer.catch_stack[lowerer.catch_stack.length-1]; result.ok=true; return result }

void emit_checked_failure(llvm_lowerer* lowerer, string condition, string error_name, string message, string prefix) {
    BootstrapActiveCatchResult active = active_catch(lowerer)
    string fail_label = next_label(lowerer, prefix + ".fail")
    string ok_label = next_label(lowerer, prefix + ".ok")
    raw_line(lowerer, `  br i1 ${condition}, label %${ok_label}, label %${fail_label}`)
    raw_line(lowerer, fail_label + ":")
    if !active.ok {
        raw_line(lowerer, "  call void @abort()")
        raw_line(lowerer, "  unreachable")
        raw_line(lowerer, ok_label + ":")
        return
    }
    int64 id = lowerer.result.error_type_ids["builtin::" + error_name]
    SemanticType* message_type = new SemanticType(); message_type.kind="string"; message_type.name="string"
    IRValue message_value = static_string_value(lowerer, message, message_type)
    store_error_value(lowerer, active.context.error_value, "1", `${id}`, message_value.value)
    emit_catch_scope_cleanups(lowerer, active.context)
    raw_line(lowerer, `  br label %${active.context.end_label}`)
    raw_line(lowerer, ok_label + ":")
}

void emit_catch_scope_cleanups(llvm_lowerer* lowerer, catch_context context) {
    int64 start = context.block_depth
    if start < 0 { start = 0 }
    if start > lowerer.block_stack.length { start = lowerer.block_stack.length }
    int64 index = lowerer.block_stack.length - 1
    while index >= start {
        emit_value_cleanup_scope(lowerer, index)
        emit_lifetime_cleanups(lowerer, lowerer.block_stack[index].node)
        emit_mecc_clear_root_scope(lowerer, index)
        index -= 1
    }
}

void emit_control_scope_cleanups(llvm_lowerer* lowerer, int64 start) {
    if start < 0 { start = 0 }
    int64 index = lowerer.block_stack.length - 1
    while index >= start {
        emit_value_cleanup_scope(lowerer, index)
        emit_lifetime_cleanups(lowerer, lowerer.block_stack[index].node)
        emit_mecc_clear_root_scope(lowerer, index)
        index -= 1
    }
}

void emit_value_cleanup_scope(llvm_lowerer* lowerer, int64 index) {
    if index < 0 || index >= lowerer.value_cleanup_scopes.length { return }
    value_cleanup[] cleanups = lowerer.value_cleanup_scopes[index]
    int64 i = cleanups.length - 1
    while i >= 0 {
        value_cleanup cleanup = cleanups[i]
        string value = next_register(lowerer)
        raw_line(lowerer, `  ${value} = load ptr, ptr ${cleanup.address}`)
        emit_destroy_value(lowerer, value, cleanup.type_info)
        raw_line(lowerer, `  store ptr null, ptr ${cleanup.address}`)
        i -= 1
    }
}

void emit_value_cleanups_from(llvm_lowerer* lowerer, int64 start) {
    if start < 0 { start = 0 }
    int64 index = lowerer.value_cleanup_scopes.length - 1
    while index >= start {
        emit_value_cleanup_scope(lowerer, index)
        index -= 1
    }
}

void emit_destroy_value(llvm_lowerer* lowerer, string value, SemanticType* type_info) {
    type_info = specialize_type(lowerer, type_info)
    if type_info == null || value == "" || (semantic_is_pointer(type_info) && type_info.kind != "array" && type_info.array_dimensions.length == 0) { return }
    string non_null = next_register(lowerer)
    string destroy_label = next_label(lowerer, "value.destroy")
    string done_label = next_label(lowerer, "value.destroy.done")
    raw_line(lowerer, `  ${non_null} = icmp ne ptr ${value}, null`)
    raw_line(lowerer, `  br i1 ${non_null}, label %${destroy_label}, label %${done_label}`)
    raw_line(lowerer, destroy_label + ":")
    emit_destroy_value_nonnull(lowerer, value, type_info)
    raw_line(lowerer, `  br label %${done_label}`)
    raw_line(lowerer, done_label + ":")
}

void emit_destroy_call_temporary(llvm_lowerer* lowerer, IRValue value) {
    if is_value_aggregate(value.type_info) { emit_destroy_value(lowerer, value.value, value.type_info); return }
    if value.fresh && value.type_info != null && value.type_info.kind == "string" { raw_line(lowerer, `  call void @free(ptr ${value.value})`) }
}

void emit_destroy_value_nonnull(llvm_lowerer* lowerer, string value, SemanticType* type_info) {
    if lowerer.result.mecc_enabled { raw_line(lowerer, `  call void @clyth_mecc_owner_release(ptr ${value})`) }
    if type_info.kind == "array" || type_info.array_dimensions.length > 0 { emit_destroy_array_value(lowerer, value, type_info); return }
    if type_info.kind != "struct" { return }
    StructInfo* info = lowerer.struct_info[base_type_name(type_info)]
    if info == null { raw_line(lowerer, `  call void @free(ptr ${value})`); return }
    if info.destructor { raw_line(lowerer, `  call void @${llvm_destructor_name(info.name)}(ptr ${value})`) }
    int64 i = 0
    while i < info.field_order.length {
        string name = info.field_order[i]
        Symbol* field = info.fields[name]
        if field != null {
            SemanticType* field_type = specialize_type(lowerer, field.type_info)
            if is_value_aggregate(field_type) {
                string address = field_address(lowerer, value, info, name)
                string nested = next_register(lowerer)
                raw_line(lowerer, `  ${nested} = load ptr, ptr ${address}`)
                emit_destroy_value(lowerer, nested, field_type)
            }
        }
        i += 1
    }
    raw_line(lowerer, `  call void @free(ptr ${value})`)
}

void emit_destroy_array_value(llvm_lowerer* lowerer, string header, SemanticType* type_info) {
    string data = array_data_pointer(lowerer, header)
    SemanticType* element = array_element_type(lowerer, type_info)
    if is_value_aggregate(element) {
        string length_slot = next_register(lowerer); raw_line(lowerer, `  ${length_slot} = getelementptr i8, ptr ${header}, i64 8`)
        string length = next_register(lowerer); raw_line(lowerer, `  ${length} = load i64, ptr ${length_slot}`)
        string index_slot = next_register(lowerer); raw_line(lowerer, `  ${index_slot} = alloca i64`); raw_line(lowerer, `  store i64 0, ptr ${index_slot}`)
        string cond_label = next_label(lowerer, "value.destroy.cond"); string body_label = next_label(lowerer, "value.destroy.body"); string end_label = next_label(lowerer, "value.destroy.end")
        raw_line(lowerer, `  br label %${cond_label}`); raw_line(lowerer, cond_label + ":")
        string index = next_register(lowerer); raw_line(lowerer, `  ${index} = load i64, ptr ${index_slot}`)
        string more = next_register(lowerer); raw_line(lowerer, `  ${more} = icmp ult i64 ${index}, ${length}`)
        raw_line(lowerer, `  br i1 ${more}, label %${body_label}, label %${end_label}`); raw_line(lowerer, body_label + ":")
        string address = next_register(lowerer); raw_line(lowerer, `  ${address} = getelementptr ptr, ptr ${data}, i64 ${index}`)
        string nested = next_register(lowerer); raw_line(lowerer, `  ${nested} = load ptr, ptr ${address}`); emit_destroy_value(lowerer, nested, element)
        string next = next_register(lowerer); raw_line(lowerer, `  ${next} = add i64 ${index}, 1`); raw_line(lowerer, `  store i64 ${next}, ptr ${index_slot}`); raw_line(lowerer, `  br label %${cond_label}`)
        raw_line(lowerer, end_label + ":")
    }
    raw_line(lowerer, `  call void @free(ptr ${data})`); raw_line(lowerer, `  call void @free(ptr ${header})`)
}

Symbol* lookup_error_type_symbol(llvm_lowerer* lowerer, Namespace* namespace, string name, Map<Namespace*, bool> seen) { if namespace==null || seen[namespace] {return null}; seen[namespace]=true; Symbol* symbol=namespace.symbols[name]; if symbol!=null && symbol.kind=="error_type" {return symbol}; int64 i=0; while i<namespace.open_imports.length {Symbol* found=lookup_error_type_symbol(lowerer,namespace.open_imports[i],name,seen); if found!=null{return found}; i+=1}; return null }

void store_error_value(llvm_lowerer* lowerer, string object, string flag, string error_type, string message) {
    StructInfo* info = lowerer.struct_info["Error"]
    if info == null { return }
    string flag_address = field_address(lowerer, object, info, "error"); raw_line(lowerer, `  store i1 ${flag}, ptr ${flag_address}`)
    string type_address = field_address(lowerer, object, info, "error_type"); raw_line(lowerer, `  store i32 ${error_type}, ptr ${type_address}`)
    string message_address = field_address(lowerer, object, info, "error_message"); raw_line(lowerer, `  store ptr ${message}, ptr ${message_address}`)
}

IRValue emit_catch(llvm_lowerer* lowerer, CallExpr* call, SemanticType* result_sem) {
    StructInfo* info=lowerer.struct_info["Error"]; string object=next_register(lowerer); raw_line(lowerer,`  ${object} = call ptr @calloc(i64 1, i64 ${struct_storage_size(lowerer,info)})`)
    SemanticType* string_type=new SemanticType(); string_type.kind="string"; string_type.name="string"; IRValue empty=static_string_value(lowerer,"",string_type); store_error_value(lowerer,object,"0","0",empty.value)
    string end_label=next_label(lowerer,"catch.end"); catch_context context; context.error_value=object; context.end_label=end_label; context.block_depth=lowerer.block_stack.length; int64 n=lowerer.catch_stack.length; lowerer.catch_stack = array<catch_context>(lowerer.catch_stack, n+1); lowerer.catch_stack[n]=context
    if call.Arguments.length==1 {if call.Arguments[0].kind==EXPR_LAMBDA {LambdaExpr* lambda=bootstrap_as_lambda_expr(call.Arguments[0]); bool terminated=emit_block(lowerer,lambda.Body); if !terminated {raw_line(lowerer,`  br label %${end_label}`)}} else {IRValue callback=emit_expr(lowerer,call.Arguments[0]); raw_line(lowerer,`  call void ${callback.value}()`); raw_line(lowerer,`  br label %${end_label}`)}} else {raw_line(lowerer,`  br label %${end_label}`)}
    lowerer.catch_stack = array<catch_context>(lowerer.catch_stack, lowerer.catch_stack.length-1); raw_line(lowerer,end_label+":"); IRValue result; result.llvm_type="ptr"; result.value=object; result.type_info=new SemanticType(); result.type_info.kind="struct"; result.type_info.name="Error"; result.fresh=true; return result
}

bool bootstrap_string_contains_text(string value, string needle) { int64 n=bootstrap_string_length(value); int64 m=bootstrap_string_length(needle); if m==0{return true}; if m>n{return false}; int64 i=0; while i+m<=n {if bootstrap_string_slice(value,i,m)==needle{return true};i+=1};return false }

