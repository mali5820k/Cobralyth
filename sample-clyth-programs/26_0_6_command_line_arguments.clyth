extern C int32 printf(string formatted_string, ...)

int32 main(string[] args) {
    printf("argument count: %d\n", args.length)

    if args.length > 0 {
        printf("program name: %s\n", args[0])
    }

    if args.length > 1 {
        printf("first user argument: %s\n", args[1])
    }

    return 0
}
