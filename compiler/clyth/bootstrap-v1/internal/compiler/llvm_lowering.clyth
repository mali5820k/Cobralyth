            string reg=next_register(lowerer); raw_line(lowerer, `  ${reg} = call ptr @${constructor_name}(${key.llvm_type} ${key.value}, ${mapped.llvm_type} ${mapped.value})`); value.llvm_type="ptr"; value.value=reg; value.type_info=elem_sem
