import file-io
/**
 * Confirms that a source path is a readable Clyth file.
 *
 * @arg: string - source path
 * @returns: bool - true when Stage 0 can consume the file
 */
bool source_is_valid(string source_path) {
    if file_exists(source_path) != 1 { return false }
    return has_extension(source_path, ".clyth") == 1
}
