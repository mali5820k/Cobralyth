    string elem_ty=llvm_type(lowerer,elem_sem); int64 count=item.Elements.length; int64 bytes=count*llvm_storage_size(lowerer, elem_ty); if bytes==0 {bytes=1}
    string data=next_register(lowerer); raw_line(lowerer, `  ${data} = call ptr @malloc(i64 ${bytes})`)
