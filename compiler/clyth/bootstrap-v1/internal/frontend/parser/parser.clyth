}

SwitchCase*[] append_switch_case(SwitchCase*[] values, SwitchCase* value) {
    int64 n = values.length
    SwitchCase*[] replacement = array<SwitchCase*>(n + 1)
    int64 i = 0
    while i < n { replacement[i] = values[i]; i += 1 }
