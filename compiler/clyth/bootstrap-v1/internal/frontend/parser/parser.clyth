    int64 n = values.length
    TypeRef*[] replacement = array<TypeRef*>(n + 1)
    int64 i = 0
    while i < n { replacement[i] = values[i]; i += 1 }
    replacement[n] = value
    return replacement
}

Parameter*[] append_parameter(Parameter*[] values, Parameter* value) {
    int64 n = values.length
    Parameter*[] replacement = array<Parameter*>(n + 1)
    int64 i = 0
    while i < n { replacement[i] = values[i]; i += 1 }
    replacement[n] = value
    return replacement
}

Stmt[] append_stmt(Stmt[] values, Stmt value) {
    int64 n = values.length
    Stmt[] replacement = array<Stmt>(n + 1)
    int64 i = 0
    while i < n { replacement[i] = values[i]; i += 1 }
    replacement[n] = value
