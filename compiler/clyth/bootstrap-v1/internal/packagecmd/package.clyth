struct BootstrapStringResult { string value string error_message bool ok }

string Run(string command, string[] args, Writer out, Writer errOut) {
    if command == "package" {
        if args.length != 1 { return "usage: clyth package <module-directory>" }
        BootstrapStringResult result = Package(args[0])
        if result.ok { bootstrap_writer_line(out, result.value) }
        return result.error_message
    } else if command == "add-registry" {
        return setRegistry(false, args, out)
    } else if command == "update-registry" {
        return setRegistry(true, args, out)
    } else if command == "remove-registry" {
        if args.length != 1 { return "usage: clyth remove-registry <name>" }
        return removeRegistry(args[0], out)
    } else if command == "list-registries" {
        return listRegistries(out)
    } else if command == "registry-info" {
        return registryInfo(args, out)
    } else if command == "list" {
        return list_packages(out)
    } else if command == "info" {
        return package_info(args, out)
    } else if command == "init" {
        return init_project(args, out)
    } else if command == "debug" {
        return debug_project(out)
    } else if command == "update" {
        return updatePackages(args, out)
    } else if command == "install" {
        return install(args, out)
    } else if command == "remove" {
        if args.length != 1 { return "usage: clyth remove <package>" }
        return removePackage(args[0], out)
    } else if command == "refresh" {
        return refresh(out)
    }
    return "unsupported package command "+command
}

