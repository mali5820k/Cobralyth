import llvm-ir

extern C int32 puts(string text)

int32 main() {
    LLVMModule module = LLVMModule("smoke")
    module.append_line(llvm_function_begin("main", llvm_i32(), ""))
    module.append_line(llvm_label("entry"))
    module.append_line(llvm_ret(llvm_integer(llvm_i32(), "0")))
    module.append_line(llvm_function_end())
    puts(module.render())
    return 0
}
