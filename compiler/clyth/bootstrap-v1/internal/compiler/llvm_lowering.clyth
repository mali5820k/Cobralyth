IRValue emit_string_concat(llvm_lowerer* lowerer, IRValue left, IRValue right) {
    SemanticType* string_type=new SemanticType(); string_type.kind="string"; string_type.name="string"
    string left_len=next_register(lowerer); raw_line(lowerer,`  ${left_len} = call i64 @strlen(ptr ${left.value})`)
    string right_len=next_register(lowerer); raw_line(lowerer,`  ${right_len} = call i64 @strlen(ptr ${right.value})`)
    string total=next_register(lowerer); raw_line(lowerer,`  ${total} = add i64 ${left_len}, ${right_len}`)
    string capacity=next_register(lowerer); raw_line(lowerer,`  ${capacity} = add i64 ${total}, 1`)
    string buffer=next_register(lowerer); raw_line(lowerer,`  ${buffer} = call ptr @malloc(i64 ${capacity})`)
    raw_line(lowerer,`  call ptr @memcpy(ptr ${buffer}, ptr ${left.value}, i64 ${left_len})`)
    string right_dest=next_register(lowerer); raw_line(lowerer,`  ${right_dest} = getelementptr i8, ptr ${buffer}, i64 ${left_len}`)
    raw_line(lowerer,`  call ptr @memcpy(ptr ${right_dest}, ptr ${right.value}, i64 ${right_len})`)
    string nul=next_register(lowerer); raw_line(lowerer,`  ${nul} = getelementptr i8, ptr ${buffer}, i64 ${total}`)
    raw_line(lowerer,`  store i8 0, ptr ${nul}`)
    IRValue out; out.llvm_type="ptr"; out.value=buffer; out.type_info=string_type; out.fresh=true; return out
}

SemanticType* array_element_type(llvm_lowerer* lowerer, SemanticType* array_type) {
    if array_type==null {SemanticType* unknown=new SemanticType(); unknown.kind="unknown"; return unknown}; SemanticType* result=clone_type(array_type)
    if result.array_dimensions.length>0 {int64 n=result.array_dimensions.length; int64 i=0; while i+1<n {result.array_dimensions[i]=result.array_dimensions[i+1]; i+=1}; result.array_dimensions = array<SemanticArrayDimension>(result.array_dimensions, n-1)}
    if result.array_dimensions.length>0 {result.kind="array"; return result}; if result.pointer_depth>0 {result.kind="pointer"; return result}
    if result.name=="bool" {result.kind="bool"} else if result.name=="char" {result.kind="char"} else if result.name=="string" {result.kind="string"} else if result.name=="float32"||result.name=="float64" {result.kind="float"} else if result.name=="int8"||result.name=="int16"||result.name=="int32"||result.name=="int64"||result.name=="uint8"||result.name=="uint16"||result.name=="uint32"||result.name=="uint64"||result.name=="uintptr" {result.kind="integer"} else {result.kind="struct"}; return result
}

